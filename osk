#!/usr/bin/env python3
"""osk - управление экранной клавиатурой wvkbd по конфигу osk.toml.

Настройки (размер, прозрачность, шрифт, цвета, слои) берутся из osk.toml и
передаются wvkbd флагами при запуске, поэтому перекомпиляция не нужна.

  osk start | stop | restart   запуск/остановка/перезапуск (применяет osk.toml)
  osk show | hide | toggle     показать/скрыть (если не запущена - запустит)
  osk status [--genmon]        состояние: shown | hidden | stopped
  osk cmd                      показать итоговую командную строку wvkbd
  osk build                    пересобрать wvkbd-wide (mkwide.py из wide.toml, патчи, make)
  osk layout en|ru|toggle      сменить раскладку СИСТЕМЫ (физическая клавиатура); слой экранной
                               клавиатуры подстроится сам. Так делает и кнопка EN/RU на экране
  osk autostart on|off|status  автозапуск при входе в систему (labwc): клавиатура свёрнута + значок раскладки
  osk start --hidden           запустить клавиатуру свёрнутой (независимо от start_hidden в конфиге)
  osk slot                     для xfce4-panel (плагин «Генератор монитора»): пустое место под значок раскладки
  osk layer en|ru              выбрать слой экранной клавиатуры (нужен wvkbd, собранный с патчем layout-sync)
  osk float on|off|toggle      плавающая (компактная, двигается) / полная клавиатура; нужен wvkbd с патчем float (`osk build`)
  osk float size up|down|0.6   размер плавающей (доля от полной, пропорционально; шрифт не меняется)
  osk float reset              вернуть положение и размер плавающей по умолчанию
  osk float status             текущее состояние плавающего режима

Конфиг: $OSK_CONFIG или ~/.config/osk/osk.toml
"""
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
CONF = Path(os.environ.get("OSK_CONFIG", HOME / ".config/osk/osk.toml"))
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
STATE = RUN / "osk.state"
PIDFILE = RUN / "osk.pid"
FSTATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "osk" / "float.json"   # режим, позиция, размер плавающей
FLT = {}                                # секция [floating] из osk.toml (заполняет load)
FLOAT_DEFAULTS = {
    "start": False,                    # начинать сразу в плавающем режиме (дальше запоминается выбор из меню)
    "scale": 0.5,                      # размер плавающей: доля от полной (ширина и высота пропорционально)
    "step": 1.15,                      # шаг кнопок «больше / меньше»
    "min_scale": 0.25,
    "button": 40,                      # размер круглой кнопки, когда клавиатура свёрнута, px
    "font": "",                        # шрифт плавающей; пусто = как у полной (keyboard.font). Размер букв не масштабируется
    "layers": ["widefen", "widefru"],  # слои плавающей (с круглой кнопкой в углу)
    "x": 24,                           # положение по умолчанию (px от левого верхнего угла)
    "y": 24,
}
SOCK = RUN / "osk-tray.sock"            # команды значку в трее (osk-tray)
SYNC_MARK = b"OSK_LAYER_SYNC_V1"        # метка в wvkbd, собранном с патчем layout-sync
TRAY = {}                               # секция [tray] из osk.toml (заполняет load)
LOG = HOME / ".cache/osk/wvkbd.log"

DEFAULTS = {
    "binary": "",                      # путь к wvkbd-wide; пусто - искать в PATH и в source_dir
    "source_dir": str(HOME / "wvkbd"),
    "height": 300,                     # -H, высота в портретной ориентации
    "landscape_height": 300,           # -L, высота в ландшафте
    "font": "Sans 12",                 # --fn
    "alpha": 235,                      # --alpha 0..255
    "rounding": 6,                     # -R
    "layers": [],                      # -l, например ["wideen", "wideru"]
    "landscape_layers": [],            # --landscape-layers
    "start_hidden": False,
    "non_exclusive": True,             # --non-exclusive: не резервировать полосу экрана, панель не сдвигается
}
COLOR_FLAGS = {
    "bg": "--bg", "fg": "--fg", "fg_sp": "--fg-sp", "press": "--press",
    "press_sp": "--press-sp", "swipe": "--swipe", "swipe_sp": "--swipe-sp",
    "text": "--text", "text_sp": "--text-sp",
}


def load():
    data = {}
    try:
        with open(CONF, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        print(f"osk: нет конфига {CONF}, работаю с настройками по умолчанию", file=sys.stderr)
    kb = {**DEFAULTS, **data.get("keyboard", {})}
    FLT.clear()
    FLT.update({**FLOAT_DEFAULTS, **data.get("floating", {})})
    TRAY.clear()
    TRAY.update(data.get("tray", {}))
    for k in ("binary", "source_dir"):
        kb[k] = os.path.expanduser(kb[k]) if kb[k] else kb[k]
    return kb, data.get("colors", {})


def find_binary(kb):
    cands = [kb["binary"], shutil.which("wvkbd-wide") or "", str(Path(kb["source_dir"]) / "wvkbd-wide")]
    for c in cands:
        if c and Path(c).is_file() and os.access(c, os.X_OK):
            return c
    sys.exit("osk: не найден wvkbd-wide (задай keyboard.binary в osk.toml или выполни `osk build`)")


def fstate():
    try:
        d = json.loads(FSTATE.read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def fsave(d):
    try:
        FSTATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = FSTATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(d))
        os.replace(tmp, FSTATE)
    except OSError as e:
        print(f"osk: не удалось сохранить {FSTATE}: {e}", file=sys.stderr)


def float_on():
    return bool(fstate().get("on", FLT.get("start", False)))


def active_layers(kb):
    """Слои, с которыми запущена клавиатура (у плавающей свои, с круглой кнопкой)."""
    if float_on():
        return list(FLT["layers"])
    return list(kb["layers"] or ["wideen", "wideru"])


def build_cmd(kb, colors, hidden):
    fl = float_on()
    c = [find_binary(kb), "-H", str(kb["height"]), "-L", str(kb["landscape_height"]),
         "--fn", (FLT["font"] if fl and FLT["font"] else kb["font"]), "--alpha", str(kb["alpha"]), "-R", str(kb["rounding"])]
    if fl:
        fs = fstate()
        c += ["-l", ",".join(FLT["layers"]), "--landscape-layers", ",".join(FLT["layers"]),
              "--float", f"{int(fs.get('x', FLT['x']))},{int(fs.get('y', FLT['y']))},{1 if fs.get('collapsed') else 0}",
              "--float-scale", str(fs.get("scale", FLT["scale"])), "--float-button", str(FLT["button"])]
    else:
        if kb["layers"]:
            c += ["-l", ",".join(kb["layers"])]
        if kb["landscape_layers"]:
            c += ["--landscape-layers", ",".join(kb["landscape_layers"])]
    for key, flag in COLOR_FLAGS.items():
        if key in colors:
            c += [flag, str(colors[key])]
    if kb["non_exclusive"]:
        c.append("--non-exclusive")
    if hidden:
        c.append("--hidden")
    return c


def wl_env():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", str(RUN))
    if "WAYLAND_DISPLAY" not in env:
        socks = sorted(p.name for p in RUN.glob("wayland-*") if not p.name.endswith(".lock"))
        env["WAYLAND_DISPLAY"] = socks[0] if socks else "wayland-0"
    return env


def pids(kb):
    name = Path(kb["binary"] or "wvkbd-wide").name
    r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", name], capture_output=True, text=True)
    found = {int(x) for x in r.stdout.split()}
    try:                                    # pid-файл: на случай, если имя процесса не совпало
        pid = int(PIDFILE.read_text())
        if name.encode() in Path(f"/proc/{pid}/cmdline").read_bytes():
            found.add(pid)
    except (OSError, ValueError):
        pass
    return sorted(found)


def set_state(s):
    try:
        STATE.write_text(s)
    except OSError:
        pass


def get_state(kb):
    if not pids(kb):
        return "stopped"
    try:
        return STATE.read_text().strip() or "shown"
    except OSError:
        return "shown"


def stop(kb):
    for p in pids(kb):
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for _ in range(20):
        if not pids(kb):
            break
        time.sleep(0.1)
    set_state("stopped")


def start(kb, colors, hidden=None):
    if hidden is None:
        hidden = bool(kb["start_hidden"])
    stop(kb)
    cmd = build_cmd(kb, colors, hidden)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    log = open(LOG, "ab")
    env = wl_env()
    me = shutil.which("osk") or str(Path(__file__).resolve())
    env["OSK_FLOAT_CMD"] = f"{me} float-event"      # плавающая сообщает, куда её перетащили / свернули
    env["OSK_LAYOUT_CMD"] = f"{me} layout"      # кнопка EN/RU на экране сообщает системе, какой язык включить
    p = subprocess.Popen(cmd, env=env, stdout=log, stderr=log, start_new_session=True)
    PIDFILE.write_text(str(p.pid))
    time.sleep(0.6)
    if p.poll() is not None:
        tail = LOG.read_text(errors="replace").splitlines()[-8:]
        sys.exit("osk: wvkbd не запустился:\n" + "\n".join(tail))
    set_state("hidden" if hidden else "shown")
    cmd_layer(kb, read_sys_layout(), quiet=True)      # слой экранной клавиатуры = текущий язык системы


# ---------- раскладка: система <-> экранная клавиатура ----------

def read_sys_layout():
    """EN / RU - раскладка системы (файл пишет kbd-layout-feeder.sh по xkb-monitor)."""
    path = os.path.expanduser(TRAY.get("layout_state_file") or str(RUN / "kbd-layout"))
    try:
        return Path(path).read_text().strip().upper()[:2]
    except OSError:
        return ""


def norm_layout(arg):
    a = (arg or "").strip().lower()
    if a.startswith("widef"):
        a = a[5:]
    elif a.startswith("wide"):
        a = a[4:]
    if a in ("en", "ru"):
        return a.upper()
    if a in ("toggle", "switch", ""):
        return "TOGGLE"
    sys.exit("osk: раскладка: en, ru или toggle")


def layer_signal(kb, code):
    """Сигнал wvkbd, выбирающий слой по коду раскладки: SIGRTMIN+N = N-й слой из keyboard.layers."""
    for i, name in enumerate(active_layers(kb)):
        if name.lower().endswith(code.lower()):
            return signal.SIGRTMIN + 1 + i
    return None


def supports_sync(pid):
    try:
        return SYNC_MARK in Path(f"/proc/{pid}/exe").read_bytes()
    except OSError:
        return False


def cmd_layer(kb, code, quiet=False):
    sig = layer_signal(kb, code) if code in ("EN", "RU") else None
    if sig is None:
        return
    for p in pids(kb):
        if supports_sync(p):                  # старый wvkbd от такого сигнала завершился бы
            try:
                os.kill(p, sig)
            except ProcessLookupError:
                pass
        elif not quiet:
            print("osk: этот wvkbd собран без патча layout-sync: выполни `osk build` и `osk restart`", file=sys.stderr)


def tray_send(msg):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        s.sendto(msg.encode(), str(SOCK))
        return True
    except OSError:                           # значка нет или сокет устарел
        return False
    finally:
        s.close()


def inject_toggle():
    """Смена раскладки без значка: Alt+Shift через виртуальную клавиатуру uinput (нужен доступ к /dev/uinput)."""
    try:
        from evdev import UInput, ecodes
        codes = [getattr(ecodes, k) for k in TRAY.get("toggle_keys", ["KEY_LEFTALT", "KEY_LEFTSHIFT"])]
        ui = UInput({ecodes.EV_KEY: codes}, name="osk-layout-switch")
        time.sleep(0.4)                       # compositor должен заметить новое устройство
        for c in codes:
            ui.write(ecodes.EV_KEY, c, 1)
            ui.syn()
        time.sleep(0.04)
        for c in reversed(codes):
            ui.write(ecodes.EV_KEY, c, 0)
            ui.syn()
        time.sleep(0.1)
        ui.close()
        return True
    except Exception as e:
        print(f"osk: не удалось сменить раскладку: {e}", file=sys.stderr)
        return False


def cmd_layout(kb, arg):
    code = norm_layout(arg)
    if tray_send("layout " + code.lower()):   # значок держит uinput открытым, отвечает мгновенно
        return
    cur = read_sys_layout()
    target = ("RU" if cur == "EN" else "EN") if code == "TOGGLE" else code
    if target != cur and inject_toggle():
        cmd_layer(kb, target, quiet=True)     # значка нет, подстраиваем слой сами


def cmd_float(kb, colors, a):
    sub = a[0] if a else "status"
    fs = fstate()
    st = get_state(kb)
    cur = bool(fs.get("on", FLT["start"]))

    def apply(restart=True):
        fsave(fs)
        if restart and st != "stopped":
            start(kb, colors, hidden=(st == "hidden"))

    if sub in ("on", "off", "toggle"):
        new = {"on": True, "off": False, "toggle": not cur}[sub]
        fs["on"] = new
        apply()
        print("плавающая клавиатура включена" if new else "полная клавиатура включена")
    elif sub == "size":
        sc = float(fs.get("scale", FLT["scale"]))
        arg = a[1] if len(a) > 1 else "up"
        if arg in ("up", "+", "bigger"):
            sc *= float(FLT["step"])
        elif arg in ("down", "-", "smaller"):
            sc /= float(FLT["step"])
        else:
            try:
                sc = float(arg)
                sc = sc / 100 if sc > 1 else sc
            except ValueError:
                sys.exit("osk float size up|down|<доля 0.25..1 или проценты>")
        fs["scale"] = max(float(FLT["min_scale"]), min(1.0, round(sc, 3)))
        apply(restart=cur)
        print("размер плавающей:", fs["scale"], "(доля от полной)")
    elif sub == "reset":
        fs.update(x=FLT["x"], y=FLT["y"], collapsed=False, scale=FLT["scale"])
        apply(restart=cur)
        print("положение и размер плавающей сброшены")
    elif sub == "status":
        print("режим:", "плавающая" if cur else "полная", "| размер:", fs.get("scale", FLT["scale"]),
              "| позиция:", fs.get("x", FLT["x"]), fs.get("y", FLT["y"]), "| свёрнута:", bool(fs.get("collapsed")))
    else:
        sys.exit("osk float on|off|toggle|size up|down|N|reset|status")


def cmd_float_event(a):
    """Вызывается самой wvkbd (OSK_FLOAT_CMD): pos X Y | collapsed X Y | expanded X Y."""
    if len(a) < 3:
        return
    try:
        what, x, y = a[0], int(a[1]), int(a[2])
    except ValueError:
        return
    fs = fstate()
    fs.update(x=x, y=y)
    if what == "collapsed":
        fs["collapsed"] = True
    elif what == "expanded":
        fs["collapsed"] = False
    fsave(fs)


def signal_to(kb, sig, state):
    for p in pids(kb):
        os.kill(p, sig)
    set_state(state)


def genmon(kb):
    st = get_state(kb)
    icon = {"shown": "\u2328 ON", "hidden": "\u2328 off", "stopped": "\u2328 \u2715"}[st]
    me = shutil.which("osk") or str(Path(__file__).resolve())
    print(f"<txt>{icon}</txt>")
    print(f"<txtclick>{me} toggle</txtclick>")
    print(f"<tool>Экранная клавиатура: {st}</tool>")


def slot():
    """Вывод для плагина genmon панели xfce: прозрачная картинка, которая резервирует в панели место под значок."""
    img = Path(os.path.realpath(__file__)).parent / "ICONs" / "tray" / "slot.png"
    print(f"<img>{img}</img>")
    print("<tool>Здесь значок раскладки (osk-tray)</tool>")


def build(kb):
    src = Path(kb["source_dir"])
    steps = [["python3", "mkwide.py"]]
    if (src / "patch_keyboard.py").exists():
        steps.append(["python3", "patch_keyboard.py"])
    steps += [["make", "LAYOUT=wide", "clean"], ["make", "LAYOUT=wide", "wvkbd-wide"]]
    for s in steps:
        print("osk build:", " ".join(s))
        r = subprocess.run(s, cwd=src, capture_output=True, text=True)
        if r.returncode:
            sys.exit((r.stdout + r.stderr)[-1500:] + f"\nosk: шаг «{' '.join(s)}» завершился с ошибкой")
        if s[0] == "python3":
            print("  " + r.stdout.strip().replace("\n", "\n  "))
    print("osk build: готово, примени командой `osk restart`")


AUTOSTART = HOME / ".config/labwc/autostart"
A_BEGIN, A_END = "# >>> osk-autostart (управляется командой `osk autostart`, руками не править)", "# <<< osk-autostart"
A_BLOCK = f"""{A_BEGIN}
( sleep 4; "$HOME/.local/bin/osk" start --hidden; "$HOME/.local/bin/osk-tray" start ) >/dev/null 2>&1 &
{A_END}
"""


def cmd_autostart(arg):
    txt = AUTOSTART.read_text() if AUTOSTART.exists() else ""
    has = A_BEGIN in txt
    if arg == "status":
        print("автозапуск: ВКЛЮЧЁН" if has else "автозапуск: выключен", f"({AUTOSTART})")
        other = [l for l in txt.splitlines() if ("osk-tray" in l or "/osk " in l) and not l.startswith("#") and A_BEGIN not in l]
        if other and not has:
            print("в файле уже есть свои строки запуска:", *other, sep="\n  ")
        return
    if arg not in ("on", "off"):
        sys.exit("osk autostart on|off|status")
    if has:                                                   # убираем прежний блок (для on - чтобы записать заново)
        head, _, rest = txt.partition(A_BEGIN)
        _, _, tail = rest.partition(A_END)
        txt = head.rstrip("\n") + ("\n" if head.strip() else "") + tail.lstrip("\n")
    if arg == "on":
        if AUTOSTART.exists() and not (AUTOSTART.parent / "autostart.bak-osk").exists():
            shutil.copy(AUTOSTART, AUTOSTART.parent / "autostart.bak-osk")       # копия на всякий случай (один раз)
        AUTOSTART.parent.mkdir(parents=True, exist_ok=True)
        txt = (txt.rstrip("\n") + "\n" if txt.strip() else "") + A_BLOCK
    AUTOSTART.write_text(txt)
    print("автозапуск включён: после входа в систему клавиатура запустится свёрнутой, значок появится сам"
          if arg == "on" else "автозапуск выключен")


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "toggle"
    if cmd == "autostart":
        return cmd_autostart(a[1] if len(a) > 1 else "status")
    kb, colors = load()
    st = get_state(kb)
    if cmd in ("start", "restart"):
        start(kb, colors, hidden=True if "--hidden" in a else None)
    elif cmd == "stop":
        stop(kb)
    elif cmd == "show":
        start(kb, colors, hidden=False) if st == "stopped" else signal_to(kb, signal.SIGUSR2, "shown")
    elif cmd == "hide":
        if st != "stopped":
            signal_to(kb, signal.SIGUSR1, "hidden")
    elif cmd == "toggle":
        if st == "stopped":
            start(kb, colors, hidden=False)
        else:
            signal_to(kb, signal.SIGRTMIN, "hidden" if st == "shown" else "shown")
    elif cmd == "status":
        genmon(kb) if "--genmon" in a else print(st)
    elif cmd == "cmd":
        print(" ".join(build_cmd(kb, colors, bool(kb["start_hidden"]))))
    elif cmd == "build":
        build(kb)
    elif cmd == "slot":
        slot()
    elif cmd == "layout":
        cmd_layout(kb, a[1] if len(a) > 1 else "toggle")
    elif cmd == "float":
        cmd_float(kb, colors, a[1:])
    elif cmd == "float-event":
        cmd_float_event(a[1:])
    elif cmd == "layer":
        cmd_layer(kb, norm_layout(a[1] if len(a) > 1 else "").replace("TOGGLE", ""))
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
