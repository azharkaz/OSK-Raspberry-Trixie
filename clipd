#!/usr/bin/env python3
"""clipd - мультибуфер обмена для Wayland (labwc) с историей и синхронизацией
через Syncthing в формате ContextMenu-TVBox (папка claude_bufer).

  clipd watch              демон: следит за буфером (запускать из autostart)
  clipd pick [--paste] [--toggle]  окно истории (--toggle: повторный вызов закрывает окно); меню: входящие, последние клипы и история всех устройств
  clipd tpl [--paste|--copy] [--toggle]  окно шаблонов (папка templates: файлы .txt или без расширения, подпапки, симлинки)
  clipd tpl-export [--force] [--no-prune]  скопировать наши шаблоны в templates_export_dir (для jbak2 на Android, без дублей)
  clipd send [УСТРОЙСТВО]  отправить текущий буфер в to_<УСТРОЙСТВО>.txt (all - всем)
  clipd store [--primary]  служебное: принять содержимое буфера со stdin

Конфиг: секция [clipboard] в ~/.config/osk/osk.toml (или ~/.config/clipd/config.toml)
"""
import fcntl
import fnmatch
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from datetime import datetime
from pathlib import Path

