def cmd_pick_menu(cfg, paste):
    """Простое меню fuzzel (запасной вариант)."""
    items = collect(cfg)
    if not items:
        notify("Буфер пуст")
        return
    lines = [f"{i:04d}  {lab}  {flat(t)}" for i, (lab, t) in enumerate(items)]
    sel = menu(cfg, lines, "Буфер")
    if not sel:
        return
    m = re.match(r"\s*(\d{4})\s", sel)
    if not m or int(m.group(1)) >= len(items):
        return
    deliver(cfg, items[int(m.group(1))][1], paste)


# ---------- окно с вкладками (GTK) ----------

def tab_label(cfg, name):
    custom = cfg["tab_labels"].get(name)
    if custom:
        return str(custom)
    stem = name[:-4] if name.endswith(".txt") else name
    if stem.startswith("clip_hist-"):
        return f"История {stem[len('clip_hist-'):]}"
    if stem == "to_all":
        return "\u2192 всем"
    if stem.startswith("to_"):
        return f"\u2192 {stem[3:]}"
    return f"\u25cf {stem}"                 # последний клип устройства


def file_entries(p):
    """-> [(метка времени или "", текст)], новые первыми."""
    raw = read_text(p)
    parts = SPLIT.split(raw)
    if len(parts) >= 3:                      # файл истории
        ents = [(parts[i], parts[i + 1].removesuffix("\n")) for i in range(1, len(parts) - 1, 2)]
        return [(ts, t) for ts, t in reversed(ents) if t.strip()]
    return [("", raw)] if raw.strip() else []


def tab_sort_key(cfg, name):
    order = cfg["tab_order"]
    if name in order:
        return (0, order.index(name), "", name)
    stem = name[:-4] if name.endswith(".txt") else name
    me = cfg["device"]
    hist = stem.startswith("clip_hist-")
    dev = stem[len("clip_hist-"):] if hist else (stem[3:] if stem.startswith("to_") else stem)
    if dev == me and not stem.startswith("to_"):
        rank = 1                              # свои файлы
    elif stem in (f"to_{me}", "to_all"):
        rank = 2                              # входящие
    elif stem.startswith("to_"):
        rank = 4                              # адресованное другим
    else:
        rank = 3                              # чужие устройства
    return (1, rank, dev, (1 if hist else 0, name))


def collect_tabs(cfg):
    d = Path(cfg["sync_dir"])
    tabs = []
    for p in d.glob("*"):
        n = p.name
        if not p.is_file() or n.startswith("."):
            continue
        if not any(fnmatch.fnmatch(n, g) for g in cfg["include"]):
            continue
        if any(fnmatch.fnmatch(n, g) for g in cfg["exclude"]):
            continue
        ents = file_entries(p)
        if ents or cfg["show_empty_tabs"]:
            tabs.append({"name": n, "label": tab_label(cfg, n), "entries": ents})
    tabs.sort(key=lambda t: tab_sort_key(cfg, t["name"]))
    return tabs


STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "osk"
WIN_STATE = STATE_DIR / "clip-win.json"        # размер и положение окна истории
TRAY_STATE = STATE_DIR / "tray-pos.json"       # сюда значок пишет высоту панели
PICK_PID = RUN / "clipd-pick.pid"


def short_text(text, lines=4, width=180):
    """Первые несколько строк записи для списка (длинные строки режем, остаток помечаем)."""
    ls = text.strip().splitlines() or [""]
    out = [l if len(l) <= width else l[:width] + "\u2026" for l in ls[:lines]]
    if len(ls) > lines:
        out[-1] += f"   \u2026 (ещё строк: {len(ls) - lines})"
    return "\n".join(out)


def mutate_entry(cfg, name, ts, old, new):
    """Изменить (new - текст) или удалить (new=None) запись файла. История: запись ищется по метке и тексту;
    одиночный файл (to_*.txt, последний клип): текст заменяется или файл очищается. -> True, если сделано."""
    p = Path(cfg["sync_dir"]) / name
    lk = lock("store")                                    # noqa: F841 (не пересекаться с записью новых клипов)
    raw = read_text(p)
    if len(SPLIT.split(raw)) >= 3:
        items = parse_history(p)
        for i, (t0, x) in enumerate(items):
            if t0 == ts and x == old:
                if new is None:
                    del items[i]
                else:
                    items[i] = (t0, new)
                atomic_write(p, "".join(entry(tx, tt) for tt, tx in items))
                log(f"запись {'удалена' if new is None else 'изменена'}: {name} {ts}")
                return True
        return False
    atomic_write(p, "" if new is None else new)
    log(f"файл {'очищен' if new is None else 'изменён'}: {name}")
    return True


def osk_reserved():
    """Сколько px занимает показанная экранная клавиатура (0, если скрыта или не запущена)."""
    try:
        pid = int((RUN / "osk.pid").read_text())
        if b"wvkbd" not in Path(f"/proc/{pid}/cmdline").read_bytes():
            return 0
        if (RUN / "osk.state").read_text().strip() != "shown":
            return 0
        with open(OSK_CONF, "rb") as f:
            k = tomllib.load(f).get("keyboard", {})
        return int(k.get("landscape_height", k.get("height", 300)))
    except (OSError, ValueError, tomllib.TOMLDecodeError):
        return 0


def panel_height():
    try:
        return int(json.loads(TRAY_STATE.read_text()).get("panel_h", 40))
    except (OSError, ValueError, TypeError):
        return 40


def load_geo(path=None):
    try:
        d = json.loads((path or WIN_STATE).read_text())
        return {k: int(d[k]) for k in ("x", "y", "w", "h")}
    except (OSError, ValueError, KeyError, TypeError):
        return None


def save_geo(geo, path=None):
    try:
        path = path or WIN_STATE
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(geo))
    except OSError:
        pass


def import_layer_shell():
    """gtk-layer-shell нужно загрузить раньше GTK (порядок библиотек). None, если недоступен."""
    if not os.environ.get("WAYLAND_DISPLAY"):
        return None
    try:
        import gi
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell as L
    except (ValueError, ImportError):
        log("нет gtk-layer-shell (sudo apt install gir1.2-gtklayershell-0.1): окно может прятаться под клавиатурой")
        return None
    return L


def build_window(cfg, tabs, choose, L=None):
    """Собрать окно; choose(text, paste) вызывается при выборе записи.
    Возвращает (win, nb, lists, search, state). Поверх экранной клавиатуры (слой overlay) окно рисуется
    без рамки, поэтому заголовок для перетаскивания, крестик и уголок для изменения размера - свои."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    win = Gtk.Window(title="Буфер обмена")
    layer = bool(L) and L.is_supported()
    disp = Gdk.Display.get_default()
    try:
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        SW, SH = mon.get_geometry().width, mon.get_geometry().height
    except Exception:
        SW, SH = 1920, 1080
    geo = None
    if layer:
        reserved = osk_reserved() + (panel_height() if osk_reserved() else 0)
        saved = load_geo()
        w = max(360, min(saved["w"] if saved else cfg["window_width"], SW))
        h = max(240, min(saved["h"] if saved else cfg["window_height"], SH - 20))
        if saved:
            x, y = saved["x"], saved["y"]
        else:                                           # по центру, выше клавиатуры
            x = (SW - w) // 2
            y = max(10, SH - reserved - h - 20) if reserved else max(10, (SH - h) // 2)
        geo = {"x": max(0, min(x, SW - w)), "y": max(0, min(y, SH - 60)), "w": w, "h": h}
        L.init_for_window(win)
        L.set_namespace(win, "osk-clip")
        L.set_layer(win, L.Layer.OVERLAY)
        if hasattr(L, "set_keyboard_mode"):
            L.set_keyboard_mode(win, L.KeyboardMode.ON_DEMAND)
        else:
            L.set_keyboard_interactivity(win, True)
        L.set_exclusive_zone(win, -1)
        L.set_anchor(win, L.Edge.TOP, True)
        L.set_anchor(win, L.Edge.LEFT, True)
        L.set_margin(win, L.Edge.TOP, geo["y"])
        L.set_margin(win, L.Edge.LEFT, geo["x"])
        win.set_default_size(geo["w"], geo["h"])
        win.set_size_request(geo["w"], geo["h"])
        win.set_decorated(False)
        css = Gtk.CssProvider()
        css.load_from_data(b""".osk-clip { border: 1px solid #777; border-radius: 8px; }
                              .osk-head { font-weight: bold; padding: 4px 6px; }
                              .osk-grip { padding: 2px 6px; color: #888; }""")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    else:
        win.set_default_size(cfg["window_width"], cfg["window_height"])
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_keep_above(True)
        win.set_position(Gtk.WindowPosition.MOUSE)     # на Wayland игнорируется

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.get_style_context().add_class("osk-clip")
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(6)
    win.add(box)

    state = {"q": "", "paste": True}
    lists = []

    def row_matches(row, *_):
        return not state["q"] or state["q"] in row.osk_text.lower()

    # ---- заголовок: перетаскивание и крестик ----
    if layer:
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        handle = Gtk.EventBox()
        handle.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                          Gdk.EventMask.POINTER_MOTION_MASK)
        title = Gtk.Label(label="☰  Буфер обмена  (потяните, чтобы переместить)")
        title.set_xalign(0)
        title.get_style_context().add_class("osk-head")
        handle.add(title)
        head.pack_start(handle, True, True, 0)
        close = Gtk.Button(label="✕")
        close.set_focus_on_click(False)
        close.connect("clicked", lambda *_: win.close())
        head.pack_start(close, False, False, 0)
        box.pack_start(head, False, False, 0)
        drag = {"on": False, "x": 0, "y": 0}

        def apply_pos():
            L.set_margin(win, L.Edge.TOP, geo["y"])
            L.set_margin(win, L.Edge.LEFT, geo["x"])
            win.queue_resize()

        def h_press(_w, ev):
            if ev.button == 1:
                drag.update(on=True, x=ev.x, y=ev.y)
            return True

        def h_motion(_w, ev):
            if drag["on"]:
                geo["x"] = max(0, min(geo["x"] + int(ev.x - drag["x"]), SW - 80))
                geo["y"] = max(0, min(geo["y"] + int(ev.y - drag["y"]), SH - 40))
                apply_pos()
            return True

        def h_release(_w, ev):
            drag["on"] = False
            save_geo(geo)
            return True

        handle.connect("button-press-event", h_press)
        handle.connect("motion-notify-event", h_motion)
        handle.connect("button-release-event", h_release)

    stack = Gtk.Stack()
    lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    stack.add_named(lst, "list")
    box.pack_start(stack, True, True, 0)
    search = Gtk.SearchEntry()
    search.set_placeholder_text("Поиск по всем записям вкладки...")
    lst.pack_start(search, False, False, 0)
    nb = Gtk.Notebook()
    nb.set_scrollable(True)
    lst.pack_start(nb, True, True, 0)

    def selected_row():
        lb = lists[nb.get_current_page()]
        return lb.get_selected_row()

    def selected_text():
        row = selected_row()
        return row.osk_text if row else None

    mt = {}

    def mtime(name):
        try:
            return os.stat(Path(cfg["sync_dir"]) / name).st_mtime_ns
        except OSError:
            return None

    def make_row(ts, text, name):
        row = Gtk.ListBoxRow()
        row.osk_text, row.osk_ts, row.osk_file = text, ts, name
        row.set_tooltip_text(text[:1000])
        rbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for side in ("top", "bottom", "start", "end"):
            getattr(rbox, f"set_margin_{side}")(5)
        if ts:
            tl = Gtk.Label()
            tl.set_markup('<span size="small" alpha="60%">' +
                          GLib.markup_escape_text(ts.replace("T", " ")) + "</span>")
            tl.set_xalign(0)
            rbox.pack_start(tl, False, False, 0)
        lab = Gtk.Label(label=short_text(text, int(cfg["row_lines"])))
        lab.set_xalign(0)
        lab.set_line_wrap(True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        rbox.pack_start(lab, False, False, 0)
        row.add(rbox)
        return row

    def fill(i, entries, name):
        lb = lists[i]
        keep = None
        cur = lb.get_selected_row()
        if cur is not None:
            keep = (cur.osk_ts, cur.osk_text)
        for ch in lb.get_children():
            lb.remove(ch)
        sel = None
        for ts, text in entries[:cfg["rows_per_tab"]]:
            row = make_row(ts, text, name)
            lb.add(row)
            if keep == (ts, text):
                sel = row
        lb.show_all()
        if sel is not None:
            lb.select_row(sel)
        mt[name] = mtime(name)

    def refresh():
        """Окно открыто, а клипы продолжают приходить: перечитываем изменившиеся файлы."""
        if stack.get_visible_child_name() != "list":
            return True
        for i, tab in enumerate(tabs):
            if mtime(tab["name"]) != mt.get(tab["name"]):
                fill(i, file_entries(Path(cfg["sync_dir"]) / tab["name"]), tab["name"])
        return True

    def force_refresh(name):
        mt.pop(name, None)
        refresh()

    # ---- контекстное меню, правка и удаление ----
    menu_state = {"del_row": None, "del_id": 0}
    edit = {"row": None}
    etv = Gtk.TextView()
    etv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    ebuf = etv.get_buffer()

    def do_choose(paste_it):
        t = selected_text()
        if t is None:
            notify("Сначала выберите запись (клик по ней)")
        else:
            choose(t, paste_it)

    def start_edit(*_):
        row = selected_row()
        if row is None:
            notify("Сначала выберите запись (клик по ней)")
            return
        edit["row"] = row
        ebuf.set_text(row.osk_text)
        stack.set_visible_child_name("edit")
        etv.grab_focus()

    def cancel_edit(*_):
        edit["row"] = None
        stack.set_visible_child_name("list")
        search.grab_focus()

    def save_edit(*_):
        row = edit["row"]
        new = ebuf.get_text(ebuf.get_start_iter(), ebuf.get_end_iter(), True)
        if row is None:
            return cancel_edit()
        if not new.strip():
            notify("Пустой текст не сохраняю. Чтобы убрать запись, нажмите «Удалить»")
            return
        if not mutate_entry(cfg, row.osk_file, row.osk_ts, row.osk_text, new):
            notify("Запись не найдена: файл изменился. Список обновлён")
        name = row.osk_file
        cancel_edit()
        force_refresh(name)

    def delete_sel(*_):
        row = selected_row()
        if row is None:
            notify("Сначала выберите запись (клик по ней)")
            return
        if menu_state["del_row"] is row:                    # второе нажатие: подтверждение
            menu_state["del_row"] = None
            b_del.set_label("Удалить")
            if not mutate_entry(cfg, row.osk_file, row.osk_ts, row.osk_text, None):
                notify("Запись не найдена: файл изменился. Список обновлён")
            force_refresh(row.osk_file)
            return
        menu_state["del_row"] = row
        b_del.set_label("Точно удалить?")

        def disarm():
            if menu_state["del_row"] is row:
                menu_state["del_row"] = None
                b_del.set_label("Удалить")
            return False

        GLib.timeout_add(3000, disarm)

    def on_lb_press(lb, ev):
        if ev.button != 3:
            return False
        row = lb.get_row_at_y(int(ev.y))
        if row is None:
            return False
        lb.select_row(row)
        m = Gtk.Menu()
        for label, fn in (("Вставить", lambda *_: do_choose(True)),
                          ("Только копировать", lambda *_: do_choose(False)),
                          ("Изменить...", start_edit),
                          ("Удалить", delete_sel)):
            it = Gtk.MenuItem(label=label)
            it.connect("activate", fn)
            m.append(it)
        m.show_all()
        m.popup_at_pointer(ev)
        return True

    for tab in tabs:
        lb = Gtk.ListBox()
        lb.set_selection_mode(Gtk.SelectionMode.SINGLE)
        lb.set_activate_on_single_click(False)          # клик выделяет, двойной клик или Enter - вставляет
        lb.set_filter_func(row_matches)
        lb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        lb.connect("button-press-event", on_lb_press)
        lb.connect("row-activated", lambda _lb, row: choose(row.osk_text, state["paste"]))
        sw = Gtk.ScrolledWindow()
        sw.add(lb)
        lists.append(lb)
        nb.append_page(sw, Gtk.Label(label=tab["label"]))
    for i, tab in enumerate(tabs):
        fill(i, tab["entries"], tab["name"])
    GLib.timeout_add(int(cfg["refresh_ms"]), refresh)

    # ---- страница правки записи ----
    epage = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    el = Gtk.Label(label="Правка записи   (Ctrl+Enter - сохранить, Esc - отмена)")
    el.set_xalign(0)
    el.get_style_context().add_class("osk-head")
    epage.pack_start(el, False, False, 0)
    esw = Gtk.ScrolledWindow()
    esw.add(etv)
    epage.pack_start(esw, True, True, 0)
    ebar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    e_save = Gtk.Button(label="Сохранить")
    e_cancel = Gtk.Button(label="Отмена")
    e_save.connect("clicked", save_edit)
    e_cancel.connect("clicked", cancel_edit)
    ebar.pack_start(e_save, False, False, 0)
    ebar.pack_start(e_cancel, False, False, 0)
    epage.pack_start(ebar, False, False, 0)
    stack.add_named(epage, "edit")

    # ---- нижняя панель: кнопки и уголок изменения размера ----
    bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    b_paste = Gtk.Button(label="Вставить")
    b_copy = Gtk.Button(label="Копировать")
    b_edit = Gtk.Button(label="Изменить")
    b_del = Gtk.Button(label="Удалить")
    for b in (b_paste, b_copy, b_edit, b_del):
        b.set_focus_on_click(False)
        bottom.pack_start(b, False, False, 0)
    b_paste.connect("clicked", lambda *_: do_choose(True))
    b_copy.connect("clicked", lambda *_: do_choose(False))
    b_edit.connect("clicked", start_edit)
    b_del.connect("clicked", delete_sel)
    if layer:
        grip_box = Gtk.EventBox()
        grip_box.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                            Gdk.EventMask.POINTER_MOTION_MASK)
        grip = Gtk.Label(label="◢  размер")
        grip.get_style_context().add_class("osk-grip")
        grip_box.add(grip)
        bottom.pack_end(grip_box, False, False, 0)
        rs = {"on": False, "x": 0, "y": 0}

        def g_press(_w, ev):
            if ev.button == 1:
                rs.update(on=True, x=ev.x, y=ev.y)
            return True

        def g_motion(_w, ev):
            if rs["on"]:
                geo["w"] = max(360, min(geo["w"] + int(ev.x - rs["x"]), SW - geo["x"]))
                geo["h"] = max(240, min(geo["h"] + int(ev.y - rs["y"]), SH - geo["y"]))
                win.set_size_request(geo["w"], geo["h"])
                win.resize(geo["w"], geo["h"])
            return True

        def g_release(_w, ev):
            rs["on"] = False
            save_geo(geo)
            return True

        grip_box.connect("button-press-event", g_press)
        grip_box.connect("motion-notify-event", g_motion)
        grip_box.connect("button-release-event", g_release)
    lst.pack_start(bottom, False, False, 0)

    def on_search(entry):
        state["q"] = entry.get_text().lower()
        for lb in lists:
            lb.invalidate_filter()

    def on_search_enter(_entry):
        lb = lists[nb.get_current_page()]
        for row in lb.get_children():
            if row_matches(row):
                choose(row.osk_text, state["paste"])
                return

    search.connect("search-changed", on_search)
    search.connect("activate", on_search_enter)

    def on_key(_w, ev):
        editing = stack.get_visible_child_name() == "edit"
        if ev.keyval == Gdk.KEY_Escape:
            if editing:
                cancel_edit()
            else:
                win.close()
            return True
        if editing and ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ev.state & Gdk.ModifierType.CONTROL_MASK:
            save_edit()
            return True
        if not editing and ev.keyval == Gdk.KEY_Delete and not search.has_focus():
            delete_sel()
            return True
        return False

    win.connect("key-press-event", on_key)
    if cfg["close_on_focus_out"] and not layer:      # слой overlay: закрытие крестиком, Esc или выбором записи
        armed = {"on": False}
        GLib.timeout_add(600, lambda: armed.update(on=True) or False)    # сразу после открытия фокус может прыгать
        win.connect("focus-out-event", lambda *_: win.close() if armed["on"] else False)
    return win, nb, lists, search, state


def proc_running(pidfile):
    try:
        pid = int(pidfile.read_text())
        if b"clipd" in Path(f"/proc/{pid}/cmdline").read_bytes() and pid != os.getpid():
            return pid
    except (OSError, ValueError):
        pass
    return None


def pick_running():
    return proc_running(PICK_PID)


def cmd_pick_gtk(cfg, paste, toggle=False):
    pid = pick_running()
    if pid and toggle:                         # повторный вызов закрывает окно
        os.kill(pid, signal.SIGTERM)
        return
    L = import_layer_shell()                   # до импорта GTK
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib, Gtk
    except Exception as e:                     # нет GTK - запасное меню
        log(f"GTK недоступен: {e}")
        notify("Нет GTK для окна с вкладками: sudo apt install python3-gi gir1.2-gtk-3.0")
        return cmd_pick_menu(cfg, paste)
    tabs = collect_tabs(cfg)
    if not tabs:
        notify("Буфер пуст")
        return
    chosen = {"text": None, "paste": paste}

    def choose(text, do_paste):
        chosen["text"], chosen["paste"] = text, do_paste
        win.close()

    win, nb, lists, search, state = build_window(cfg, tabs, choose, L)
    state["paste"] = paste
    win.connect("destroy", Gtk.main_quit)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (win.close(), False)[1])
    try:
        PICK_PID.write_text(str(os.getpid()))
    except OSError:
        pass
    win.show_all()
    search.grab_focus()
    log(f"окно открыто, вкладок: {len(tabs)}, layer-shell: {bool(L)}")
    Gtk.main()
    try:
        PICK_PID.unlink()
    except OSError:
        pass
    if chosen["text"] is not None:
        deliver(cfg, chosen["text"], chosen["paste"])
    else:
        log("окно закрыто без выбора")


def cmd_pick(cfg, paste, toggle=False):
    if cfg["ui"] == "gtk":
        cmd_pick_gtk(cfg, paste, toggle)
    else:
        cmd_pick_menu(cfg, paste)


# ---------- шаблоны ----------

TPL_WIN = STATE_DIR / "tpl-win.json"            # размер и положение окна шаблонов
TPL_PID = RUN / "clipd-tpl.pid"


def tpl_root(cfg):
    d = cfg["templates_dir"] or str(Path(cfg["sync_dir"]) / "templates")
    return Path(os.path.expanduser(d))


def tpl_exts(cfg):
    return {str(e).lower().lstrip(".") for e in cfg["templates_exts"]}


def tpl_name_ok(name, cfg, all_files=False):
    """Шаблон - файл с разрешённым расширением (по умолчанию txt и без расширения); скрытые и временные пропускаем.
    all_files (для чужих папок, например jbak2): берём любой файл с именем без служебных признаков - в имени
    шаблона jbak2 бывают точки, не являющиеся расширением; бинарные файлы отсеиваются по содержимому."""
    if name.startswith(".") or name.endswith("~") or name.endswith(".tmp"):
        return False
    if all_files:
        return True
    ext = Path(name).suffix.lower().lstrip(".")
    return ext in tpl_exts(cfg)


def tpl_is_text(path):
    try:
        with open(path, "rb") as f:
            chunk = f.read(2048)
        if b"\0" in chunk:
            return False
        chunk.decode("utf-8")
        return True
    except UnicodeDecodeError as e:
        return e.reason == "unexpected end of data" or e.end >= len(chunk) - 3      # обрезанный на границе символ
    except OSError:
        return False


def tpl_display(name):
    return name[:-4] if name.lower().endswith(".txt") else name


def tpl_scan(root, cfg, _anc=None, all_files=False, skip=()):
    """Дерево шаблонов: {"dirs": [(имя, узел)], "files": [(имя для списка, путь, mtime)]}.
    Симлинки на папки и файлы работают (is_dir/is_file идут по ссылке); от петель страхуемся realpath предков.
    Пустые папки (где нет ни одного шаблона) не показываем. skip - realpath папок, которые не заходим (папка экспорта)."""
    anc = set(_anc or ())
    try:
        real = os.path.realpath(root)
    except OSError:
        return {"dirs": [], "files": []}
    anc.add(real)
    dirs, files = [], []
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name.casefold())
    except OSError:
        return {"dirs": [], "files": []}
    for e in entries:
        if e.name.startswith("."):
            continue
        try:
            if e.is_dir():
                rp = os.path.realpath(e.path)
                if rp in anc or rp in skip:
                    continue
                sub = tpl_scan(e.path, cfg, anc, all_files, skip)
                if sub["dirs"] or sub["files"]:
                    dirs.append((e.name, sub))
            elif e.is_file() and tpl_name_ok(e.name, cfg, all_files):
                if all_files and Path(e.name).suffix.lower().lstrip(".") not in tpl_exts(cfg) and not tpl_is_text(e.path):
                    continue
                files.append((tpl_display(e.name), e.path, e.stat().st_mtime_ns))
        except OSError:
            continue                                        # битая ссылка и т.п.
    return {"dirs": dirs, "files": files}


def tpl_extras(cfg):
    out = []
    for x in cfg["templates_extra"] or []:
        try:
            d = os.path.expanduser(str(x["dir"]))
        except (KeyError, TypeError):
            continue
        out.append((str(x.get("label") or Path(d).name), d, bool(x.get("all_files", True))))
    return out


def tpl_tree(cfg):
    """Наши шаблоны + чужие папки (jbak2 и т.п.) как отдельные папки списка. Папку экспорта в чужих папках не показываем,
    иначе наши же шаблоны отобразились бы дважды."""
    tree = tpl_scan(tpl_root(cfg), cfg)
    skip = set()
    if str(cfg["templates_export_dir"]).strip():
        skip.add(os.path.realpath(os.path.expanduser(cfg["templates_export_dir"])))
    own_real = os.path.realpath(tpl_root(cfg))
    for label, d, allf in tpl_extras(cfg):
        if not os.path.isdir(d) or os.path.realpath(d) == own_real:
            continue
        sub = tpl_scan(d, cfg, all_files=allf, skip=skip)
        if sub["dirs"] or sub["files"]:
            names = {n for n, _ in tree["dirs"]}
            tree["dirs"].append((label if label not in names else label + " (внешняя)", sub))
    return tree


def tpl_walk(node, prefix=()):
    """Все шаблоны дерева: (путь из папок, имя, путь к файлу)."""
    for name, path, _mt in node["files"]:
        yield prefix, name, path
    for dname, sub in node["dirs"]:
        yield from tpl_walk(sub, prefix + (dname,))


def tpl_sig(node):
    return (tuple((n, p, m) for n, p, m in node["files"]),
            tuple((n, tpl_sig(s)) for n, s in node["dirs"]))


def tpl_read(cfg, path):
    try:
        with open(path, "rb") as f:
            data = f.read(int(cfg["templates_max_bytes"]) + 1)
    except OSError:
        return ""
    if len(data) > int(cfg["templates_max_bytes"]):
        data = data[:int(cfg["templates_max_bytes"])]
    return data.decode("utf-8", "replace").replace("\x00", "")


def build_tpl_window(cfg, L, root, choose, default_action):
    """Окно шаблонов: папки как строки (вход по двойному клику), поиск по всем шаблонам, вставка/копирование."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    win = Gtk.Window(title="Шаблоны")
    layer = bool(L) and L.is_supported()
    disp = Gdk.Display.get_default()
    try:
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        SW, SH = mon.get_geometry().width, mon.get_geometry().height
    except Exception:
        SW, SH = 1920, 1080
    geo = None
    if layer:
        reserved = osk_reserved() + (panel_height() if osk_reserved() else 0)
        saved = load_geo(TPL_WIN)
        w = max(360, min(saved["w"] if saved else cfg["window_width"], SW))
        h = max(240, min(saved["h"] if saved else cfg["window_height"], SH - 20))
        if saved:
            x, y = saved["x"], saved["y"]
        else:
            x = (SW - w) // 2
            y = max(10, SH - reserved - h - 20) if reserved else max(10, (SH - h) // 2)
        geo = {"x": max(0, min(x, SW - w)), "y": max(0, min(y, SH - 60)), "w": w, "h": h}
        L.init_for_window(win)
        L.set_namespace(win, "osk-tpl")
        L.set_layer(win, L.Layer.OVERLAY)
        if hasattr(L, "set_keyboard_mode"):
            L.set_keyboard_mode(win, L.KeyboardMode.ON_DEMAND)
        else:
            L.set_keyboard_interactivity(win, True)
        L.set_exclusive_zone(win, -1)
        L.set_anchor(win, L.Edge.TOP, True)
        L.set_anchor(win, L.Edge.LEFT, True)
        L.set_margin(win, L.Edge.TOP, geo["y"])
        L.set_margin(win, L.Edge.LEFT, geo["x"])
        win.set_default_size(geo["w"], geo["h"])
        win.set_size_request(geo["w"], geo["h"])
        win.set_decorated(False)
        css = Gtk.CssProvider()
        css.load_from_data(b""".osk-clip { border: 1px solid #777; border-radius: 8px; }
                              .osk-head { font-weight: bold; padding: 4px 6px; }
                              .osk-grip { padding: 2px 6px; color: #888; }
                              .osk-path { padding: 2px 6px; color: #888; }""")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    else:
        win.set_default_size(cfg["window_width"], cfg["window_height"])
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_keep_above(True)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.get_style_context().add_class("osk-clip")
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(6)
    win.add(box)

    if layer:                                                # заголовок: перетаскивание и крестик
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        handle = Gtk.EventBox()
        handle.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                          Gdk.EventMask.POINTER_MOTION_MASK)
        title = Gtk.Label(label="☰  Шаблоны  (потяните, чтобы переместить)")
        title.set_xalign(0)
        title.get_style_context().add_class("osk-head")
        handle.add(title)
        head.pack_start(handle, True, True, 0)
        close = Gtk.Button(label="✕")
        close.set_focus_on_click(False)
        close.connect("clicked", lambda *_: win.close())
        head.pack_start(close, False, False, 0)
        box.pack_start(head, False, False, 0)
        drag = {"on": False, "x": 0, "y": 0}

        def h_press(_w, ev):
            if ev.button == 1:
                drag.update(on=True, x=ev.x, y=ev.y)
            return True

        def h_motion(_w, ev):
            if drag["on"]:
                geo["x"] = max(0, min(geo["x"] + int(ev.x - drag["x"]), SW - 80))
                geo["y"] = max(0, min(geo["y"] + int(ev.y - drag["y"]), SH - 40))
                L.set_margin(win, L.Edge.TOP, geo["y"])
                L.set_margin(win, L.Edge.LEFT, geo["x"])
                win.queue_resize()
            return True

        def h_release(_w, ev):
            drag["on"] = False
            save_geo(geo, TPL_WIN)
            return True

        handle.connect("button-press-event", h_press)
        handle.connect("motion-notify-event", h_motion)
        handle.connect("button-release-event", h_release)

    search = Gtk.SearchEntry()
    search.set_placeholder_text("Поиск по всем шаблонам (по имени и тексту)...")
    box.pack_start(search, False, False, 0)
    pathlab = Gtk.Label()
    pathlab.set_xalign(0)
    pathlab.get_style_context().add_class("osk-path")
    box.pack_start(pathlab, False, False, 0)
    lb = Gtk.ListBox()
    lb.set_selection_mode(Gtk.SelectionMode.SINGLE)
    lb.set_activate_on_single_click(False)
    sw = Gtk.ScrolledWindow()
    sw.add(lb)
    box.pack_start(sw, True, True, 0)

    st = {"tree": tpl_tree(cfg), "path": [], "q": "", "cache": {}}
    st["sig"] = tpl_sig(st["tree"])

    def text_of(path):
        try:
            mt = os.stat(path).st_mtime_ns
        except OSError:
            return ""
        c = st["cache"].get(path)
        if c is None or c[0] != mt:
            c = (mt, tpl_read(cfg, path))
            st["cache"][path] = c
        return c[1]

    def node_here():
        n = st["tree"]
        for name in st["path"]:
            n = dict(n["dirs"]).get(name)
            if n is None:
                st["path"] = []
                return st["tree"]
        return n

    def mk_row(kind, label, sub=None, **attrs):
        row = Gtk.ListBoxRow()
        row.kind = kind
        for k, v in attrs.items():
            setattr(row, k, v)
        rb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for side in ("top", "bottom", "start", "end"):
            getattr(rb, f"set_margin_{side}")(5)
        l1 = Gtk.Label()
        l1.set_markup("<b>" + GLib.markup_escape_text(label) + "</b>")
        l1.set_xalign(0)
        l1.set_ellipsize(Pango.EllipsizeMode.END)
        rb.pack_start(l1, False, False, 0)
        if sub:
            l2 = Gtk.Label(label=sub)
            l2.set_xalign(0)
            l2.set_line_wrap(True)
            l2.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            rb.pack_start(l2, False, False, 0)
        row.add(rb)
        return row

    def populate():
        for ch in lb.get_children():
            lb.remove(ch)
        n_rows = int(cfg["row_lines"])
        q = st["q"]
        if q:
            pathlab.set_text("Поиск: " + q)
            found = 0
            for prefix, name, path in tpl_walk(st["tree"]):
                text = text_of(path)
                if q in name.lower() or q in text.lower():
                    where = ("/".join(prefix) + "/") if prefix else ""
                    lb.add(mk_row("file", where + name, short_text(text, n_rows), path=path))
                    found += 1
                    if found >= 200:
                        break
            if not found:
                lb.add(mk_row("none", "Ничего не найдено"))
        else:
            pathlab.set_text("Шаблоны" + "".join(" / " + p for p in st["path"]))
            node = node_here()
            if st["path"]:
                lb.add(mk_row("up", "⬑  .. (назад)"))
            for name, sub in node["dirs"]:
                cnt = sum(1 for _ in tpl_walk(sub))
                lb.add(mk_row("dir", "\U0001F4C1  " + name, f"шаблонов: {cnt}", dir=name))
            for name, path, _mt in node["files"]:
                lb.add(mk_row("file", name, short_text(text_of(path), n_rows), path=path))
            if not node["dirs"] and not node["files"]:
                lb.add(mk_row("none", "Здесь пока нет шаблонов",
                              f"Положите файлы .txt (или без расширения) в папку:\n{root}"))
        lb.show_all()
        first = next((r for r in lb.get_children() if r.kind in ("file", "dir")), None)
        if first is not None:
            lb.select_row(first)

    def activate(row, action):
        if row.kind == "up":
            st["path"] = st["path"][:-1]
            populate()
        elif row.kind == "dir":
            st["path"] = st["path"] + [row.dir]
            populate()
        elif row.kind == "file":
            choose(text_of(row.path), action)

    lb.connect("row-activated", lambda _lb, row: activate(row, default_action))

    def selected():
        return lb.get_selected_row()

    def do_btn(action):
        row = selected()
        if row is None or row.kind in ("none",):
            notify("Сначала выберите шаблон (клик по нему)")
            return
        activate(row, action)

    def on_search(entry):
        st["q"] = entry.get_text().lower().strip()
        populate()

    def on_search_enter(_e):
        row = next((r for r in lb.get_children() if r.kind == "file"), None)
        if row is not None:
            choose(text_of(row.path), default_action)

    search.connect("search-changed", on_search)
    search.connect("activate", on_search_enter)

    bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    b_paste = Gtk.Button(label="Вставить")
    b_copy = Gtk.Button(label="Копировать")
    for b in (b_paste, b_copy):
        b.set_focus_on_click(False)
        bottom.pack_start(b, False, False, 0)
    b_paste.connect("clicked", lambda *_: do_btn("paste"))
    b_copy.connect("clicked", lambda *_: do_btn("copy"))
    if layer:
        grip_box = Gtk.EventBox()
        grip_box.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                            Gdk.EventMask.POINTER_MOTION_MASK)
        grip = Gtk.Label(label="◢  размер")
        grip.get_style_context().add_class("osk-grip")
        grip_box.add(grip)
        bottom.pack_end(grip_box, False, False, 0)
        rs = {"on": False, "x": 0, "y": 0}

        def g_press(_w, ev):
            if ev.button == 1:
                rs.update(on=True, x=ev.x, y=ev.y)
            return True

        def g_motion(_w, ev):
            if rs["on"]:
                geo["w"] = max(360, min(geo["w"] + int(ev.x - rs["x"]), SW - geo["x"]))
                geo["h"] = max(240, min(geo["h"] + int(ev.y - rs["y"]), SH - geo["y"]))
                win.set_size_request(geo["w"], geo["h"])
                win.resize(geo["w"], geo["h"])
            return True

        def g_release(_w, ev):
            rs["on"] = False
            save_geo(geo, TPL_WIN)
            return True

        grip_box.connect("button-press-event", g_press)
        grip_box.connect("motion-notify-event", g_motion)
        grip_box.connect("button-release-event", g_release)
    box.pack_start(bottom, False, False, 0)

    def refresh():
        """Файлы шаблонов поменялись (Syncthing, редактор) - перечитываем."""
        new = tpl_tree(cfg)
        sig = tpl_sig(new)
        if sig != st["sig"]:
            st["tree"], st["sig"] = new, sig
            keep = selected()
            populate()
        return True

    GLib.timeout_add(2000, refresh)

    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            if st["q"]:
                search.set_text("")
            else:
                win.close()
            return True
        if ev.keyval == Gdk.KEY_BackSpace and not search.has_focus() and not st["q"] and st["path"]:
            st["path"] = st["path"][:-1]
            populate()
            return True
        return False

    win.connect("key-press-event", on_key)
    populate()
    return win, search


def cmd_tpl(cfg, a):
    paste_default = cfg["templates_action"] != "copy"
    if "--copy" in a:
        paste_default = False
    if "--paste" in a:
        paste_default = True
    default_action = "paste" if paste_default else "copy"
    pid = proc_running(TPL_PID)
    if pid and "--toggle" in a:
        os.kill(pid, signal.SIGTERM)
        return
    root = tpl_root(cfg)
    try:
        root.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        notify(f"Папка шаблонов недоступна: {root} ({e})")
        return
    L = import_layer_shell()
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib, Gtk
    except Exception as e:
        log(f"GTK недоступен: {e}")
        notify("Нет GTK для окна шаблонов: sudo apt install python3-gi gir1.2-gtk-3.0")
        return
    chosen = {"text": None, "action": default_action}

    def choose(text, action):
        chosen["text"], chosen["action"] = text, action
        win.close()

    win, search = build_tpl_window(cfg, L, root, choose, default_action)
    win.connect("destroy", Gtk.main_quit)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (win.close(), False)[1])
    try:
        TPL_PID.write_text(str(os.getpid()))
    except OSError:
        pass
    win.show_all()
    search.grab_focus()
    log(f"окно шаблонов открыто: {root}, layer-shell: {bool(L)}")
    Gtk.main()
    try:
        TPL_PID.unlink()
    except OSError:
        pass
    text = chosen["text"]
    if text is None:
        return
    if cfg["templates_strip_newline"]:
        text = text.rstrip("\r\n")                     # хвостовой перевод строки при вставке в терминал выполнил бы команду
    paste = chosen["action"] == "paste"
    log(f"шаблон: {len(text)} символов, действие {chosen['action']}")
    deliver(cfg, text, paste)
    if not paste:
        notify("Шаблон скопирован в буфер обмена")


def cmd_tpl_export(cfg, a):
    """Копия НАШИХ шаблонов в другую папку (по умолчанию - подпапка trixie внутри папки jbak2 keyboard).
    Как у jbak2: имя без .txt, текст без перевода строки в конце. Ссылки раскрываются, подпапки сохраняются.
    Дублей не будет: чужие шаблоны (папки templates_extra и всё, что на них ссылается) не копируются, папка экспорта
    в списке чужих не показывается, неизменённые файлы не трогаем; файл, изменённый на телефоне позже (новее нашего),
    не перезаписываем (--force - перезаписать)."""
    src = tpl_root(cfg)
    if not str(cfg["templates_export_dir"]).strip():
        print("templates_export_dir не задан в osk.toml")
        return 1
    dst = Path(os.path.expanduser(cfg["templates_export_dir"]))
    rs, rd = os.path.realpath(src), os.path.realpath(dst)
    extras = [os.path.realpath(d) for _l, d, _f in tpl_extras(cfg)]
    if rs == rd or rd.startswith(rs + os.sep) or rs.startswith(rd + os.sep):
        msg = f"Папки шаблонов и экспорта не должны совпадать или лежать одна в другой: {src} / {dst}"
        print(msg)
        notify(msg)
        return 1
    if rd in extras:
        msg = f"Папка экспорта не должна быть корнем чужой папки шаблонов ({dst}): нужна подпапка, например .../trixie"
        print(msg)
        notify(msg)
        return 1
    if not src.is_dir():
        print(f"Нет папки шаблонов: {src}")
        return 1
    dst.mkdir(parents=True, exist_ok=True)
    skip_files = tuple(e + os.sep for e in extras)
    tree = tpl_scan(src, cfg, skip={rd})
    copied = same = foreign = clash = newer = 0
    keep = set()
    force = "--force" in a
    for prefix, _name, path in tpl_walk(tree):
        if os.path.realpath(path).startswith(skip_files):          # это чужой шаблон (например, ссылка на папку jbak2)
            foreign += 1
            continue
        fname = os.path.basename(path)
        if cfg["templates_export_strip_ext"] and fname.lower().endswith(".txt"):
            fname = fname[:-4]
        target = dst.joinpath(*prefix) / fname
        rt = os.path.realpath(target)
        if rt in keep:                                              # a.txt и a дали бы одно имя
            clash += 1
            print(f"пропущен (то же имя после экспорта): {path}")
            continue
        keep.add(rt)
        data = Path(path).read_bytes()
        if cfg["templates_export_strip_newline"]:
            data = data.rstrip(b"\r\n")
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            if target.read_bytes() == data:
                same += 1
                continue
            if not force and target.stat().st_mtime_ns > os.stat(path).st_mtime_ns:
                newer += 1
                print(f"не тронут (в папке экспорта новее - правили на телефоне?): {target}")
                continue
        tmp = target.with_name(f".syncthing.{target.name}.tmp")
        tmp.write_bytes(data)
        os.replace(tmp, target)
        copied += 1
    removed = 0
    prune = bool(cfg["templates_export_prune"]) and "--no-prune" not in a
    if prune:                                             # внутри папки экспорта убираем то, чего у нас больше нет
        for dp, _dn, fn in os.walk(dst, topdown=False):
            for f in fn:
                p = Path(dp) / f
                if tpl_name_ok(f, cfg) and os.path.realpath(p) not in keep:
                    p.unlink()
                    removed += 1
            try:
                if Path(dp) != dst:
                    os.rmdir(dp)
            except OSError:
                pass
    msg = (f"Шаблоны -> {dst}: скопировано {copied}, без изменений {same}"
           + (f", удалено лишних {removed}" if removed else "")
           + (f", оставлено (новее в jbak2) {newer}" if newer else "")
           + (f", чужих пропущено {foreign}" if foreign else "")
           + (f", конфликтов имён {clash}" if clash else ""))
    print(msg)
    log(msg)
    notify(msg)
    return 0


# ---------- send ----------

def cmd_send(cfg, target):
    r = subprocess.run(["wl-paste", "--no-newline", "--type", "text"], capture_output=True)
    text = r.stdout.decode("utf-8", "replace")
    if r.returncode or not text:
        notify("Буфер пуст")
        return
    if not target:
        target = menu(cfg, ["all"] + known_devices(cfg), "Отправить \u2192")
        if not target:
            return
    if not re.fullmatch(r"[\w.-]+", target):
        sys.exit("недопустимое имя устройства")
    atomic_write(Path(cfg["sync_dir"]) / f"to_{target}.txt", text)
    notify(f"Отправлено \u2192 {target}")


def main():
    a = sys.argv[1:]
    cfg = load_cfg()
    cmd = a[0] if a else "pick"
    if cmd == "testpaste":
        return cmd_testpaste(cfg)
    if cmd == "watch":
        cmd_watch(cfg)
    elif cmd == "store":
        cmd_store(cfg, "--primary" in a)
    elif cmd == "tpl":
        cmd_tpl(cfg, a)
    elif cmd == "tpl-export":
        sys.exit(cmd_tpl_export(cfg, a))
    elif cmd == "pick":
        cmd_pick(cfg, "--paste" in a, "--toggle" in a)
    elif cmd == "send":
        cmd_send(cfg, a[1] if len(a) > 1 else None)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
