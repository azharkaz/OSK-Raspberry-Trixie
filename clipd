CLOSE = "\u2715 Закрыть"
SPLIT = re.compile(r"(?:^|\n)===ENTRY (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)===\n")


def load_cfg():
    cfg = dict(DEFAULTS)
    for path, section in ((CONF, None), (OSK_CONF, "clipboard")):    # второй файл главнее
        try:
            with open(path, "rb") as f:
                data = tomllib.load(f)
        except FileNotFoundError:
            continue
        cfg.update(data.get(section, {}) if section else data)
    cfg["sync_dir"] = os.path.expanduser(cfg["sync_dir"])
    return cfg


def read_text(p):
    try:
        with open(p, encoding="utf-8", errors="replace", newline="") as f:
            return f.read()
    except OSError:
        return ""


def atomic_write(path, data):
    # имя .syncthing.*.tmp Syncthing игнорирует, так что наружу временный файл не уйдёт
    tmp = path.with_name(f".syncthing.{path.name}.tmp")
    with open(tmp, "w", encoding="utf-8", newline="") as f:
        f.write(data)
    os.replace(tmp, path)


def entry(text, ts=None):
    ts = ts or datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    return f"\n===ENTRY {ts}===\n{text}\n"


def parse_history(p):
    parts = SPLIT.split(read_text(p))
    return [(parts[i], parts[i + 1].removesuffix("\n")) for i in range(1, len(parts) - 1, 2)]


def trim(hist, keep):
    items = parse_history(hist)
    if len(items) <= keep + keep // 5:
        return
    atomic_write(hist, "".join(entry(t, ts) for ts, t in items[-keep:]))


def lock(name, block=True):
    f = open(RUN / f"clipd-{name}.lock", "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except OSError:
        return None
    return f


LOGF = HOME / ".cache/clipd/clipd.log"


def log(msg):
    try:
        LOGF.parent.mkdir(parents=True, exist_ok=True)
        with open(LOGF, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
    except OSError:
        pass


def notify(msg):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "clipd", "-t", "2000", "clipd", msg])


def known_devices(cfg):
    names = set()
    for p in Path(cfg["sync_dir"]).glob("*.txt"):
        n = p.stem
        if n.startswith("clip_hist-"):
            names.add(n[len("clip_hist-"):])
        elif n.startswith("to_"):
            names.add(n[len("to_"):])
        elif not n.startswith("history_all_"):
            names.add(n)
    names.discard(cfg["device"])
    names.discard("all")
    return sorted(names)


# ---------- store ----------

def cmd_store(cfg, primary=False):
    data = sys.stdin.buffer.read()
    if not data or len(data) > cfg["max_bytes"]:
        return
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return
    text = text.replace("\x00", "")          # нулевые байты (например, из файлового менеджера) портят файл истории
    if not text.strip():
        return
    types = subprocess.run(
        ["wl-paste", "--list-types"] + (["--primary"] if primary else []),
        capture_output=True, text=True).stdout
    if "passwordManagerHint" in types:      # менеджеры паролей помечают свои клипы
        return
    d = Path(cfg["sync_dir"])
    if not d.is_dir():
        return
    me = cfg["device"]
    lk = lock("store")                      # noqa: F841 (держим блокировку до конца)
    latest = d / f"{me}.txt"
    if read_text(latest) == text:
        return
    atomic_write(latest, text)
    hist = d / f"clip_hist-{me}.txt"
    with open(hist, "a", encoding="utf-8", newline="") as f:
        f.write(entry(text))
    trim(hist, cfg["max_entries"])


# ---------- watch ----------

def cmd_watch(cfg):
    lk = lock("watch", block=False)
    if lk is None:
        sys.exit("clipd уже запущен")
    me = os.path.realpath(__file__)
    cmds = [["wl-paste", "--type", "text", "--watch", sys.executable, me, "store"]]
    if cfg["primary"]:
        cmds.append(["wl-paste", "--primary", "--type", "text", "--watch",
                     sys.executable, me, "store", "--primary"])
    procs = []

    def stop(*_):
        for p in procs:
            p.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while True:
        procs[:] = [subprocess.Popen(c) for c in cmds]
        while all(p.poll() is None for p in procs):
            time.sleep(1)
        for p in procs:
            if p.poll() is None:
                p.terminate()
            p.wait()
        time.sleep(3)                       # перезапуск, если wl-paste упал


# ---------- menu / pick ----------

def menu(cfg, lines, prompt):
    if cfg["menu"] == "wofi":
        cmd = ["wofi", "--dmenu", "-p", prompt]
    else:
        cmd = ["fuzzel", "--dmenu", "--prompt", prompt + " ", "--width", "90"]
    pos = cfg["close_item"]
    if pos == "top":
        lines = [CLOSE] + lines
    elif pos == "bottom":
        lines = lines + [CLOSE]
    r = subprocess.run(cmd, input="\n".join(lines) + "\n", text=True, capture_output=True)
    out = r.stdout.rstrip("\n") if r.returncode == 0 else None
    return None if out == CLOSE else out


def flat(t, n=110):
    s = re.sub(r"\s*\n\s*", " \u21b5 ", t.strip())
    s = re.sub(r"[ \t]+", " ", s)
    return s if len(s) <= n else s[:n - 1] + "\u2026"


def collect(cfg):
    d, me = Path(cfg["sync_dir"]), cfg["device"]
    items = []
    for name, label in ((f"to_{me}.txt", "\u21e9 мне"), ("to_all.txt", "\u21e9 всем")):
        t = read_text(d / name)
        if t.strip():
            items.append((label, t))
    for dev in known_devices(cfg):
        t = read_text(d / f"{dev}.txt")
        if t.strip():
            items.append((f"\u25cf {dev}", t))
    hist, seen, n = [], set(), 0
    for p in sorted(d.glob("clip_hist-*.txt")):
        dev = p.stem[len("clip_hist-"):]
        for ts, t in parse_history(p):
            n += 1                          # n удерживает порядок записей внутри файла
            if t.strip():
                hist.append((ts, n, dev, t))
    for ts, _, dev, t in sorted(hist, reverse=True):
        if (dev, t) in seen:
            continue
        seen.add((dev, t))
        items.append((f"{dev} {ts[5:16].replace('T', ' ')}", t))
    return items[:cfg["menu_limit"]]


def refocus_tray():
    import socket
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        s.sendto(b"refocus", str(RUN / "osk-tray.sock"))
        return True
    except OSError:
        return False
    finally:
        s.close()


def uinput_paste(mods):
    """Нажать mods+V на виртуальной клавиатуре ядра (uinput). Возвращает текст ошибки или ''."""
    try:
        from evdev import UInput, ecodes as e
        names = {"ctrl": e.KEY_LEFTCTRL, "shift": e.KEY_LEFTSHIFT, "alt": e.KEY_LEFTALT, "logo": e.KEY_LEFTMETA}
        mk = [names[m] for m in mods if m in names]
        ui = UInput({e.EV_KEY: mk + [e.KEY_V]}, name="clipd-paste")
        try:
            time.sleep(0.6)                                  # композитор должен успеть подхватить новое устройство
            for k in mk + [e.KEY_V]:
                ui.write(e.EV_KEY, k, 1); ui.syn(); time.sleep(0.03)
            time.sleep(0.03)
            for k in [e.KEY_V] + mk[::-1]:
                ui.write(e.EV_KEY, k, 0); ui.syn(); time.sleep(0.03)
            time.sleep(0.15)
        finally:
            ui.close()
        return ""
    except Exception as ex:
        return str(ex) or ex.__class__.__name__


def deliver(cfg, text, paste):
    """Положить текст в буфер и (если нужно) вставить в активное окно."""
    log(f"deliver: {len(text)} символов, paste={paste}")
    subprocess.run(["wl-copy"], input=text.encode("utf-8"))
    if not paste:
        return
    wtype = shutil.which("wtype")
    if not wtype:
        log("wtype не найден")
        notify("Для вставки нужен wtype: sudo apt install wtype (текст уже в буфере)")
        return
    ok = refocus_tray()
    if ok:
        log("refocus: команда значку отправлена")                       # слой overlay мог забрать фокус: просим значок вернуть его прежнему окну
    log(f"refocus: {'отправлено' if ok else 'значок не запущен'}")
    time.sleep(cfg["paste_delay_ms"] / 1000)
    mods = cfg["paste_mods"]
    app = read_text(RUN / "osk-focus-app").strip().lower()     # значок записывает app_id окна, которому вернул фокус
    if app and any(x in app for x in cfg["terminal_apps"]):
        mods = cfg["paste_mods_terminal"]
    log(f"окно: {app or 'неизвестно'} -> модификаторы вставки {mods}")
    method = str(cfg.get("paste_method", "uinput")).lower()
    if method == "uinput":
        err = uinput_paste(mods)
        log("вставка: Ctrl+V через uinput " + ("ok" if not err else "ОШИБКА: " + err + " -> запасной вариант wtype"))
        if not err:
            return
    elif method == "type":
        log(f"вставка: печать текста через wtype ({len(text)} символов)")
        r = subprocess.run([wtype, "-d", "2", "-"], input=text, capture_output=True, text=True)   # "-" = текст из stdin
        log(f"wtype rc={r.returncode} {r.stderr.strip()}")
        if r.returncode:
            notify("wtype не смог напечатать, см. ~/.cache/clipd/clipd.log")
        return
    args = ([wtype] + [x for m in mods for x in ("-M", m)] + ["-k", "v"]
            + [x for m in reversed(mods) for x in ("-m", m)])
    r = subprocess.run(args, capture_output=True, text=True)
    log(f"wtype rc={r.returncode} {r.stderr.strip()}")
    if r.returncode:
        notify("wtype не смог вставить, см. ~/.cache/clipd/clipd.log")


def cmd_testpaste(cfg):
    """clipd testpaste - проверка вставки: за 6 секунд кликните в поле ввода, туда придёт слово TEST-VSTAVKA."""
    print("wtype:   ", shutil.which("wtype") or "НЕ НАЙДЕН (sudo apt install wtype)")
    print("wl-copy: ", shutil.which("wl-copy") or "НЕ НАЙДЕН (sudo apt install wl-clipboard)")
