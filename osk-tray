def argb_from_rgba(px, w, h, rowstride):
    """Пиксели RGBA (с отступом строки) -> ARGB32 для StatusNotifierItem (порядок байт: A R G B)."""
    out = bytearray(w * h * 4)
    for y in range(h):
        row = px[y * rowstride: y * rowstride + w * 4]
        o = y * w * 4
        out[o:o + w * 4:4] = row[3::4]
        out[o + 1:o + w * 4:4] = row[0::4]
        out[o + 2:o + w * 4:4] = row[1::4]
        out[o + 3:o + w * 4:4] = row[2::4]
    return bytes(out)


def pixbuf_to_pixmap(pb):
    if not pb.get_has_alpha():
        pb = pb.add_alpha(False, 0, 0, 0)
    w, h = pb.get_width(), pb.get_height()
    return (w, h, argb_from_rgba(pb.get_pixels(), w, h, pb.get_rowstride()))


def pixmaps_variant(pm):
    """a(iiay) из списка (w, h, bytes). GLib.Variant("a(iiay)", ...) напрямую очень медленный на Pi."""
    items = []
    for w, h, data in pm:
        ay = GLib.Variant.new_from_bytes(GLib.VariantType("ay"), GLib.Bytes.new(data), True)
        items.append(GLib.Variant.new_tuple(GLib.Variant("i", w), GLib.Variant("i", h), ay))
    return GLib.Variant.new_array(GLib.VariantType("(iiay)"), items)


def pixmaps_from_png(path):
    out = []
    for s in ICON_SIZES:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), s, s, True)
        out.append(pixbuf_to_pixmap(pb))
    return out


