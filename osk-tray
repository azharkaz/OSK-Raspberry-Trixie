def load_cfg():
    data = {}
    try:
        with open(CONF, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        pass
    t = data.get("tray", {})
    cfg = {**DEFAULTS, **{k: v for k, v in t.items() if k != "menu"}}
    cfg["colors"] = {**DEFAULTS["colors"], **t.get("colors", {})}
    cfg["menu"] = t.get("menu") or DEFAULT_MENU
    k = data.get("keyboard", {})
    cfg["kbd_h"] = int(k.get("landscape_height", k.get("height", 300)))     # высота клавиатуры на экране 1920x1080
    if not cfg["layout_state_file"]:
        cfg["layout_state_file"] = str(RUN / "kbd-layout")
    cfg["icons_dir"] = Path(os.path.expanduser(cfg["icons_dir"])) if cfg["icons_dir"] else HERE / "ICONs" / "tray"
    return cfg



