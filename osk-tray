def pixmaps_from_svg(svg):
    out = []
    for s in (16, 22, 24, 32, 48, 64):
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(s, s)
        loader.write(svg.encode("utf-8"))
        loader.close()
        out.append(pixbuf_to_pixmap(loader.get_pixbuf()))
    return out


