# ---------------------------------------------------------------- правка TOML с сохранением комментариев
def split_val(rest):
    """'"a # b"  # note' -> ('"a # b"', '  # note'); значение отделяется от комментария с учётом кавычек."""
    q = None
    i = 0
    while i < len(rest):
        ch = rest[i]
        if q:
            if ch == "\\" and q == '"':
                i += 2
                continue
            if ch == q:
                q = None
        elif ch in "\"'":
            q = ch
        elif ch == "#":
            j = i
            while j > 0 and rest[j - 1] in " \t":
                j -= 1
            return rest[:j], rest[j:]
        i += 1
    return rest.rstrip(), ""


def fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return repr(round(v, 6))
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(fmt(x) for x in v) + "]"
    raise TypeError(v)


HDR = re.compile(r"^\s*\[([^\[\]]+)\]\s*(#.*)?$")
ANYHDR = re.compile(r"^\s*\[")


def section_range(lines, name):
    start = None
    for i, ln in enumerate(lines):
        m = HDR.match(ln)
        if m and m.group(1).strip() == name:
            start = i
            break
    if start is None:
        return None
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if ANYHDR.match(lines[j]):
            end = j
            break
    return start, end


def set_value(lines, section, key, value):
    """value=None - убрать (закомментировать) ключ. Меняет lines на месте."""
    rng = section_range(lines, section)
    keyre = re.compile(r"^(\s*)" + re.escape(key) + r"(\s*=\s*)(.*)$")
    if rng is None:
        if value is None:
            return
        while lines and lines[-1].strip() == "":
            lines.pop()
        lines += ["", f"[{section}]", f"{key} = {fmt(value)}"]
        return
    s, e = rng
    last = s
    for i in range(s + 1, e):
        ln = lines[i].rstrip("\n")
        m = keyre.match(ln)
        if m:
            old, comment = split_val(m.group(3))
            if value is None:
                lines[i] = "# " + ln.lstrip()
                return
            new = fmt(value)
            gap = comment[: len(comment) - len(comment.lstrip())] if comment else ""
            if comment:
                grow = len(new) - len(old)
                gap = " " * max(1, len(gap) - grow)
            lines[i] = m.group(1) + key + m.group(2) + new + gap + comment.lstrip()
            return
        if ln.strip() and not ln.lstrip().startswith("#"):
            last = i
    if value is None:
        return
    lines.insert(last + 1, f"{key} = {fmt(value)}")


def get_cfg(data, section):
    d = data
    for p in section.split("."):
        d = d.get(p, {}) if isinstance(d, dict) else {}
    return d if isinstance(d, dict) else {}


def parse_color(s):
    s = (s or "").strip().lstrip("#")
    if s == "":
        return ""
    if re.fullmatch(r"[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", s):
        return s.lower()
    raise ValueError(f"цвет «{s}»: нужно rrggbb или rrggbbaa")


def strlist(s):
    """«a, b, ""» -> ["a", "b", ""]; "" (две кавычки) - пустая строка, например «файлы без расширения»."""
    return ["" if x.strip() == '""' else x.strip() for x in s.split(",") if x.strip()]


def same(a, b):
    if isinstance(a, float) or isinstance(b, float):
        try:
            return abs(float(a) - float(b)) < 1e-9
        except (TypeError, ValueError):
            return False
    return a == b


def save_changes(path, changes):
    """changes: [(section, key, value|None)]. Пишет файл (с копией .bak), возвращает затронутые разделы."""
    real = Path(os.path.realpath(path))
    text = real.read_text(encoding="utf-8") if real.exists() else ""
    lines = text.split("\n")
    for sec, key, val in changes:
        set_value(lines, sec, key, val)
    out = "\n".join(lines).rstrip("\n") + "\n"
    tomllib.loads(out)                                    # проверка: файл остаётся корректным TOML
    if real.exists() and not getattr(save_changes, "_baked", False):
        save_changes.info = make_backup(real)              # не получилось - не страшно, сохранение не блокируем
        save_changes._baked = True
    fd, tmp = tempfile.mkstemp(dir=str(real.parent), prefix=".osk-settings-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(out)
    try:
        os.chmod(tmp, (real.stat().st_mode & 0o7777) if real.exists() else 0o644)    # права файла не меняем
    except OSError:
        pass
    os.replace(tmp, real)
    return {c[0] for c in changes}


# ---------------------------------------------------------------- права доступа
PASSFILE = HOME / ".config/osk/.sudo-pass"          # запомненный пароль (по желанию), права 600


class NeedPassword(Exception):
    pass


class BadPassword(Exception):
    pass


def read_pass():
    try:
        return PASSFILE.read_text(encoding="utf-8").rstrip("\n") or None
    except OSError:
        return None


def save_pass(pw):
    PASSFILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(PASSFILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(pw + "\n")
    os.chmod(PASSFILE, 0o600)


def forget_pass():
    try:
        PASSFILE.unlink()
    except OSError:
        pass


def _run(argv, inp=None, timeout=30):
    try:
        r = subprocess.run(argv, input=inp, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stderr or "") + (r.stdout or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def su_run(argv, password, timeout=20):
    """su root -c <argv> через псевдотерминал. -> 'ok' | 'need' (нужен пароль) | 'bad' (не подошёл) | 'fail'."""
    if not shutil.which("su"):
        return "fail"
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.execvp("su", ["su", "root", "-c", shlex.join(argv)])
        finally:
            os._exit(127)
    out, sent, end = "", False, time.time() + timeout
    status = None
    try:
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.3)
            if r:
                try:
                    d = os.read(fd, 4096)
                except OSError:
                    break
                if not d:
                    break
                out += d.decode("utf-8", "ignore")
                if not sent and re.search(r"(?i)(password|парол)[^\n]*:\s*$", out):
                    if password is None:
                        os.kill(pid, 9)
                        os.waitpid(pid, 0)
                        return "need"
                    os.write(fd, (password + "\n").encode())
                    sent, out = True, ""
        _, st = os.waitpid(pid, 0)
        status = os.waitstatus_to_exitcode(st)
    except OSError:
        pass
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
    if status == 0:
        return "ok"
    if sent and re.search(r"(?i)(failure|incorrect|sorry|сбой|неверн|ошибк)", out):
        return "bad"
    return "bad" if sent else "fail"


def priv_run(argv, password=None):
    """Выполнить argv от root: sudo без пароля -> su без пароля -> (с паролем) sudo -S -> su.
    Бросает NeedPassword (нужен пароль) / BadPassword (пароль не подошёл). -> (ok, сообщение)."""
    if os.geteuid() == 0:
        rc, msg = _run(argv)
        return rc == 0, msg
    if shutil.which("sudo"):
        rc, msg = _run(["sudo", "-n"] + argv)
        if rc == 0:
            return True, ""
    st = su_run(argv, None)
    if st == "ok":
        return True, ""
    if password is None:
        raise NeedPassword()
    if shutil.which("sudo"):
        rc, msg = _run(["sudo", "-S", "-p", ""] + argv, inp=password + "\n")
        if rc == 0:
            return True, ""
    if su_run(argv, password) == "ok":
        return True, ""
    raise BadPassword()


def perm_roots():
    cands = [HERE, Path(os.path.realpath(CONF)).parent, HOME / ".config/osk", HOME / ".cache/osk",
             HOME / ".local/state/osk"]
    out = []
    for c in cands:
        try:
            c = c.resolve()
        except OSError:
            continue
        if c.is_dir() and c != HOME and len(c.parts) > 2 and c not in out:
            out.append(c)
    return out


def find_bad(roots, limit=30000):
    """Файлы/папки, которые пользователь не может менять (чужой владелец или нет прав)."""
    uid, bad, n = os.getuid(), [], 0
    for root in roots:
        for dp, dns, fns in os.walk(root):
            dns[:] = [d for d in dns if d not in (".git", "node_modules", "__pycache__")]
            for name in [""] + dns + fns:
                p = os.path.join(dp, name) if name else dp
                n += 1
                if n > limit:
                    return bad
                try:
                    st = os.lstat(p)
                except OSError:
                    continue
                if os.path.islink(p):
                    continue
                isdir = os.path.isdir(p)
                need = (os.R_OK | os.W_OK | os.X_OK) if isdir else (os.R_OK | os.W_OK)
                if st.st_uid != uid or not os.access(p, need):
                    bad.append(p)
    return bad


def fix_perms(roots, ask=None):
    """Чинит владельца и права. ask(note) -> (пароль, запомнить) | None. -> (код, сообщение): код -1 = не удалось."""
    uid, gid = os.getuid(), os.getgid()
    bad = find_bad(roots)
    if not bad:
        return 0, "Права в порядке"
    for p in list(bad):                                   # свои файлы без прав - чиним без администратора
        try:
            st = os.lstat(p)
            if st.st_uid == uid:
                os.chmod(p, st.st_mode | (0o700 if os.path.isdir(p) else 0o600))
        except OSError:
            pass
    bad = find_bad(roots)
    if not bad:
        return 1, "Права исправлены"
    pw, remember, note = read_pass(), False, False
    saved = pw
    for _ in range(4):
        try:
            for i in range(0, len(bad), 150):
                chunk = " ".join(shlex.quote(p) for p in bad[i:i + 150])
                cmd = f"chown -h {uid}:{gid} -- {chunk}; chmod u+rwX -- {chunk}"
                priv_run(["sh", "-c", cmd], pw)
            break
        except NeedPassword:
            pass
        except BadPassword:
            note = True
            if pw and pw == saved:
                forget_pass()
                saved = None
        if ask is None:
            return -1, "Нужны права администратора: sudo/su просят пароль (запусти `osk settings` и введи его в окне)"
        res = ask(note)
        if res is None:
            return -1, "Исправление прав отменено (нужен пароль sudo/su)"
        pw, remember = res
    else:
        return -1, "Пароль не подошёл"
    if remember and pw:
        try:
            save_pass(pw)
        except OSError:
            pass
    left = find_bad(roots)
    if left:
        return -1, f"Не удалось исправить права у {len(left)} файлов (например {left[0]})"
    return len(bad), f"Права исправлены у {len(bad)} файлов"


def cli_fixperms():
    def ask(note):
        env = os.environ.get("OSK_SETTINGS_PASS")
        if env is not None:
            return (env, False) if not note else None
        if not sys.stdin.isatty():
            return None
        pw = getpass.getpass("Пароль (для sudo - ваш, для su - root)" + (" [прошлый не подошёл]" if note else "") + ": ")
        rem = input("Запомнить пароль (файл ~/.config/osk/.sudo-pass, права 600)? [y/N] ").strip().lower() in ("y", "д", "да")
        return pw, rem
    n, msg = fix_perms(perm_roots(), ask)
    print(msg)
    return 0 if n >= 0 else 1


def make_backup(real):
    """Копия osk.toml.bak рядом; не вышло - в ~/.cache/osk; не вышло совсем - пропускаем (сохранению не мешает)."""
    for bak in (real.with_name(real.name + ".bak"), HOME / ".cache/osk" / (real.name + ".bak")):
        try:
            bak.parent.mkdir(parents=True, exist_ok=True)
            if bak.exists() or bak.is_symlink():
                bak.unlink()
            shutil.copy2(real, bak)
            return str(bak)
        except OSError:
            continue
    return None


