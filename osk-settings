def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk
    try:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell
    except (ValueError, ImportError):
        GtkLayerShell = None

    lock = open(RUN / "osk-settings.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("osk-settings: окно уже открыто")
        return

    try:
        data = tomllib.loads(Path(os.path.realpath(CONF)).read_text(encoding="utf-8"))
    except FileNotFoundError:
        data = {}
    except tomllib.TOMLDecodeError as e:
        print(f"osk-settings: osk.toml не читается: {e}")
        return 1

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("Настройки экранной клавиатуры")
    scr = Gdk.Screen.get_default()
    plain = os.environ.get("OSK_SETTINGS_PLAIN") or GtkLayerShell is None
    if not plain:
        try:
            plain = not GtkLayerShell.is_supported()
        except Exception:
            plain = True
    sw_, sh_ = 1280, 720
    try:
        mon = scr.get_display().get_monitor(0)
        g = mon.get_geometry()
        sw_, sh_ = g.width, g.height
    except Exception:
        pass
    win.set_default_size(min(780, sw_ - 40), min(640, sh_ - 60))
    win.set_size_request(min(780, sw_ - 40), min(640, sh_ - 60))
    if not plain:
        win.set_decorated(False)
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "osk-settings")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
        if hasattr(GtkLayerShell, "set_keyboard_mode"):
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)
        else:
            GtkLayerShell.set_keyboard_interactivity(win, True)
        GtkLayerShell.set_exclusive_zone(win, -1)

    css = Gtk.CssProvider()
    css.load_from_data(b"""
        .osk-set { border: 2px solid #3d6fd8; border-radius: 8px; }
        .osk-title { font-weight: bold; font-size: 14pt; padding: 8px 12px; }
        .osk-hint { color: #888888; font-size: 9pt; }
        .osk-status { padding: 4px 12px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(scr, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win.get_style_context().add_class("osk-set")

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    win.add(root)
    title = Gtk.Label(label="Настройки экранной клавиатуры, значка и буфера обмена", xalign=0)
    title.get_style_context().add_class("osk-title")
    root.pack_start(title, False, False, 0)
    nb = Gtk.Notebook()
    nb.set_scrollable(True)
    root.pack_start(nb, True, True, 0)

    getters = {}      # (section, key) -> (get(), orig, kind, hash)
    widgets = {}

    def mk_color(spec_val, hashed):
        box = Gtk.Box(spacing=6)
        ent = Gtk.Entry()
        ent.set_width_chars(10)
        ent.set_placeholder_text("не задан")
        btn = Gtk.ColorButton()
        box.pack_start(ent, False, False, 0)
        box.pack_start(btn, False, False, 0)

        def set_btn(*_):
            try:
                c = parse_color(ent.get_text())
            except ValueError:
                return
            if c:
                rgba = Gdk.RGBA()
                if rgba.parse("#" + c[:6]):
                    btn.set_rgba(rgba)

        def picked(_b):
            c = btn.get_rgba()
            h = "%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255))
            ent.set_text(("#" if hashed else "") + h)

        ent.set_text(spec_val)
        set_btn()
        ent.connect("changed", set_btn)
        btn.connect("color-set", picked)
        clr = Gtk.Button(label="✕")
        clr.set_tooltip_text("сбросить (не задан)")
        clr.connect("clicked", lambda *_: ent.set_text(""))
        box.pack_start(clr, False, False, 0)
        return box, ent

    for tab, rows in T:
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        grid = Gtk.Grid(column_spacing=12, row_spacing=6, margin=12)
        sc.add(grid)
        nb.append_page(sc, Gtk.Label(label=tab))
        r = 0
        for sec, key, label, kind, default, opt, hint in rows:
            cur = get_cfg(data, sec).get(key, default)
            lab = Gtk.Label(label=label, xalign=0)
            lab.set_line_wrap(True)
            grid.attach(lab, 0, r, 1, 1)
            hashed = False
            if kind == "int":
                w = Gtk.SpinButton.new_with_range(opt[0], opt[1], 1)
                w.set_value(int(cur))
                get = lambda w=w: int(w.get_value())
            elif kind == "float":
                w = Gtk.SpinButton.new_with_range(opt[0], opt[1], opt[2])
                w.set_digits(2)
                w.set_value(float(cur))
                get = lambda w=w: round(w.get_value(), 4)
            elif kind == "bool":
                w = Gtk.Switch()
                w.set_active(bool(cur))
                w.set_halign(Gtk.Align.START)
                get = lambda w=w: w.get_active()
            elif kind in ("str", "path"):
                w = Gtk.Entry()
                w.set_text(str(cur))
                w.set_hexpand(True)
                get = lambda w=w: w.get_text()
            elif kind == "list":
                w = Gtk.Entry()
                w.set_text(", ".join(x if x else '""' for x in cur))
                w.set_hexpand(True)
                get = lambda w=w: strlist(w.get_text())
            elif kind == "choice":
                w = Gtk.ComboBoxText()
                for o in opt:
                    w.append_text(o)
                if str(cur) not in opt:
                    w.append_text(str(cur))
                    opt = list(opt) + [str(cur)]
                w.set_active(opt.index(str(cur)))
                get = lambda w=w: w.get_active_text()
            elif kind in ("color", "hcolor"):
                hashed = kind == "hcolor" or str(cur).startswith("#")
                w, ent = mk_color(str(cur), hashed)
                get = lambda ent=ent, hashed=hashed: ("#" if hashed else "") + parse_color(ent.get_text()) if parse_color(ent.get_text()) else ""
            elif kind in ("alpha", "alpha_f"):
                w = Gtk.Box(spacing=8)
                sc_ = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 255, 1)
                sc_.set_hexpand(True)
                sc_.set_value_pos(Gtk.PositionType.RIGHT)
                sc_.set_value(255 if int(cur) < 0 else int(cur))
                w.pack_start(sc_, True, True, 0)
                if kind == "alpha_f":
                    chk = Gtk.CheckButton(label="как у основной")
                    chk.set_active(int(cur) < 0)
                    sc_.set_sensitive(int(cur) >= 0)
                    chk.connect("toggled", lambda c, s=sc_: s.set_sensitive(not c.get_active()))
                    w.pack_start(chk, False, False, 0)
                    get = lambda sc_=sc_, chk=chk: -1 if chk.get_active() else int(sc_.get_value())
                else:
                    get = lambda sc_=sc_: int(sc_.get_value())
            grid.attach(w, 1, r, 1, 1)
            if hint:
                h = Gtk.Label(label=hint, xalign=0)
                h.set_line_wrap(True)
                h.get_style_context().add_class("osk-hint")
                grid.attach(h, 1, r + 1, 1, 1)
                r += 1
            r += 1
            have = key in get_cfg(data, sec)
            getters[(sec, key)] = (get, cur, kind, have)
            widgets[(sec, key)] = w

    status = Gtk.Label(label="", xalign=0)
    status.get_style_context().add_class("osk-status")
    status.set_line_wrap(True)
    root.pack_start(status, False, False, 0)
    bar = Gtk.Box(spacing=8, margin=10)
    bar.set_halign(Gtk.Align.END)
    b_ok = Gtk.Button(label="OK")
    b_apply = Gtk.Button(label="Применить")
    b_cancel = Gtk.Button(label="Отмена")
    for b in (b_apply, b_ok, b_cancel):
        bar.pack_start(b, False, False, 0)
    root.pack_start(bar, False, False, 0)

    def say(txt):
        status.set_text(txt)

    def run_bg(args):
        try:
            subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    def apply(_b=None):
        changes = []
        try:
            for (sec, key), (get, orig, kind, have) in getters.items():
                new = get()
                if same(new, orig):
                    continue
                if kind in ("color", "hcolor") and new == "":
                    changes.append((sec, key, None))
                else:
                    changes.append((sec, key, new))
        except ValueError as e:
            say("Ошибка: " + str(e))
            return False
        if not changes:
            say("Изменений нет")
            return True
        try:
            secs = save_changes(CONF, changes)
        except (OSError, tomllib.TOMLDecodeError) as e:
            say(f"Не удалось сохранить: {e}")
            return False
        for sec, key, val in changes:                      # новая точка отсчёта
            g, orig, kind, have = getters[(sec, key)]
            getters[(sec, key)] = (g, val if val is not None else "", kind, True)
        did = []
        if secs & RESTART_KB:
            st = subprocess.run([sys.executable, str(HERE / "osk"), "status"], capture_output=True, text=True).stdout.strip()
            if st and st != "stopped":
                run_bg([sys.executable, str(HERE / "osk"), "restart"] + (["--hidden"] if st == "hidden" else []))
                did.append("клавиатура перезапущена")
            else:
                did.append("клавиатура применит при запуске")
        if "tray" in secs:
            run_bg([sys.executable, str(HERE / "osk-tray"), "restart"])
            did.append("значок перезапущен")
        if "clipboard" in secs:
            if any(c[0] == "clipboard" and c[1] in WATCH_KEYS for c in changes):
                run_bg(["sh", "-c", f"pkill -u {os.getuid()} -f '[c]lipd watch'; sleep 1; exec {HERE / 'clipd'} watch"])
                did.append("clipd перезапущен")
            else:
                did.append("окна истории и шаблонов применят при следующем открытии")
        say("Сохранено (копия: osk.toml.bak). " + "; ".join(did))
        return True

    def ok(_b):
        if apply():
            win.close()

    b_apply.connect("clicked", apply)
    b_ok.connect("clicked", ok)
    b_cancel.connect("clicked", lambda *_: win.close())
    win.connect("key-press-event", lambda w, e: win.close() if e.keyval == Gdk.KEY_Escape else False)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    test = os.environ.get("OSK_SETTINGS_TEST")          # отладка: "раздел.ключ=значение;..." и затем сразу «Применить»
    if test:
        def drive():
            for item in test.split(";"):
                if item == "APPLY":
                    apply()
                    continue
                if item.startswith("TAB"):
                    nb.set_current_page(int(item[3:]))
                    continue
                k, v = item.split("=", 1)
                sec, key = k.rsplit(".", 1) if k.rsplit(".", 1)[0] in {s for s, _ in getters} else (k.split(".")[0], k.split(".", 1)[1])
                w = widgets[(sec, key)]
                if isinstance(w, Gtk.SpinButton):
                    w.set_value(float(v))
                elif isinstance(w, Gtk.Switch):
                    w.set_active(v == "1")
                elif isinstance(w, Gtk.Entry):
                    w.set_text(v)
                elif isinstance(w, Gtk.Box):
                    for ch in w.get_children():
                        if isinstance(ch, Gtk.Entry):
                            ch.set_text(v)
                        if isinstance(ch, Gtk.Scale):
                            ch.set_value(float(v))
                        if isinstance(ch, Gtk.CheckButton):
                            ch.set_active(False)
            return False
        GLib.timeout_add(500, drive)
    Gtk.main()


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    else:
        sys.exit(run_gui())
