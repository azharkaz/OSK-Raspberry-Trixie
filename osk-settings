                GtkLayerShell.set_keyboard_mode(dlg, GtkLayerShell.KeyboardMode.ON_DEMAND)
            GtkLayerShell.set_exclusive_zone(dlg, -1)
        if not plain:
            dlg.get_style_context().add_class("osk-set")
        dlg.set_size_request(min(520, sw_ - 40), -1)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=14)
        dlg.add(v)
        txt = ("Чтобы исправить права доступа на файлах программы, нужны права администратора.\n"
               "Введи пароль: для sudo - твой, для su - пароль root.")
        lab = Gtk.Label(label=txt, xalign=0)
        lab.set_line_wrap(True)
        v.pack_start(lab, False, False, 0)
        if note:
            err = Gtk.Label(label="Пароль не подошёл, попробуй ещё раз.", xalign=0)
            v.pack_start(err, False, False, 0)
        ent = Gtk.Entry()
        ent.set_visibility(False)
        ent.set_placeholder_text("пароль")
        v.pack_start(ent, False, False, 0)
        chk = Gtk.CheckButton(label="Запомнить пароль (файл ~/.config/osk/.sudo-pass, права 600)")
        v.pack_start(chk, False, False, 0)
        row = Gtk.Box(spacing=8)
        row.set_halign(Gtk.Align.END)
        bo, bc = Gtk.Button(label="OK"), Gtk.Button(label="Отмена")
        row.pack_start(bo, False, False, 0)
        row.pack_start(bc, False, False, 0)
        v.pack_start(row, False, False, 0)
        res = {"v": None}

        def done(_b=None):
            res["v"] = (ent.get_text(), chk.get_active())
            dlg.close()
        bo.connect("clicked", done)
        ent.connect("activate", done)
        bc.connect("clicked", lambda *_: dlg.close())
        dlg.connect("key-press-event", lambda w, e: dlg.close() if e.keyval == Gdk.KEY_Escape else False)
        dlg.connect("destroy", lambda *_: Gtk.main_quit())
        dlg.show_all()
        ent.grab_focus()
        Gtk.main()
        return res["v"]

    def do_fix():
        r = fix_perms(perm_roots(), ask_gui)
        refresh_pass_label()
        return r

    def apply(_b=None):
        changes = []
        try:
            for (sec, key), (get, orig, kind, have) in getters.items():
                new = get()
                if same(new, orig):
                    continue
                if kind in ("color", "hcolor") and new == "":
                    changes.append((sec, key, None))
                else:
                    changes.append((sec, key, new))
        except ValueError as e:
            say("Ошибка: " + str(e))
            return False
        if not changes:
            say("Изменений нет")
            return True
        secs = None
        for attempt in (1, 2):
            try:
                secs = save_changes(CONF, changes)
                break
            except PermissionError as e:
                if attempt == 2 or not auto_fix():
                    say(f"Не удалось сохранить: {e}")
                    return False
                say("Нет доступа к файлам, исправляю права...")
                n, msg = do_fix()
                if n < 0:
                    say(msg)
                    return False
            except (OSError, tomllib.TOMLDecodeError) as e:
                say(f"Не удалось сохранить: {e}")
                return False
        for sec, key, val in changes:                      # новая точка отсчёта
            g, orig, kind, have = getters[(sec, key)]
            getters[(sec, key)] = (g, val if val is not None else "", kind, True)
        did = []
        if secs & RESTART_KB:
            st = subprocess.run([sys.executable, str(HERE / "osk"), "status"], capture_output=True, text=True).stdout.strip()
            if st and st != "stopped":
                run_bg([sys.executable, str(HERE / "osk"), "restart"] + (["--hidden"] if st == "hidden" else []))
                did.append("клавиатура перезапущена")
            else:
                did.append("клавиатура применит при запуске")
        if "tray" in secs:
            run_bg([sys.executable, str(HERE / "osk-tray"), "restart"])
            did.append("значок перезапущен")
        if "clipboard" in secs:
            if any(c[0] == "clipboard" and c[1] in WATCH_KEYS for c in changes):
                run_bg(["sh", "-c", f"pkill -u {os.getuid()} -f '[c]lipd watch'; sleep 1; exec {HERE / 'clipd'} watch"])
                did.append("clipd перезапущен")
            else:
                did.append("окна истории и шаблонов применят при следующем открытии")
        bi = getattr(save_changes, "info", None)
        say("Сохранено" + (f" (копия: {bi}). " if bi else " (копию сделать не удалось). ") + "; ".join(did))
        return True

    def ok(_b):
        if apply():
            win.close()

    b_fix.connect("clicked", lambda *_: say(do_fix()[1]))
    b_forget.connect("clicked", lambda *_: (forget_pass(), refresh_pass_label()))
    refresh_pass_label()

    def startup_check():
        if auto_fix() and find_bad(perm_roots()):
            say("Нашёл файлы с неверными правами, исправляю...")
            say(do_fix()[1])
        return False
    GLib.timeout_add(300, startup_check)
    win.connect("destroy", lambda *_: geo_save())
    save_t = {"id": 0}

    def on_conf(_w, ev):
        if save_t["id"]:
            GLib.source_remove(save_t["id"])
        save_t["id"] = GLib.timeout_add(600, lambda: (geo_save(), save_t.update(id=0), False)[2])
        return False
    win.connect("configure-event", on_conf)
    b_apply.connect("clicked", apply)
    b_ok.connect("clicked", ok)
    b_cancel.connect("clicked", lambda *_: win.close())
    win.connect("key-press-event", lambda w, e: win.close() if e.keyval == Gdk.KEY_Escape else False)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    test = os.environ.get("OSK_SETTINGS_TEST")          # отладка: "раздел.ключ=значение;..." и затем сразу «Применить»
    if test:
        def drive():
            for item in test.split(";"):
                if item == "APPLY":
                    apply()
                    continue
                if item == "ASK":
                    say("ask: " + str(ask_gui(False)))
                    continue
                if item.startswith("TAB"):
                    nb.set_current_page(int(item[3:]))
                    continue
                k, v = item.split("=", 1)
                sec, key = k.rsplit(".", 1) if k.rsplit(".", 1)[0] in {s for s, _ in getters} else (k.split(".")[0], k.split(".", 1)[1])
                w = widgets[(sec, key)]
                if isinstance(w, Gtk.SpinButton):
                    w.set_value(float(v))
                elif isinstance(w, Gtk.Switch):
                    w.set_active(v == "1")
                elif isinstance(w, Gtk.Entry):
                    w.set_text(v)
                elif isinstance(w, Gtk.Box):
                    for ch in w.get_children():
                        if isinstance(ch, Gtk.Entry):
                            ch.set_text(v)
                        if isinstance(ch, Gtk.Scale):
                            ch.set_value(float(v))
                        if isinstance(ch, Gtk.CheckButton):
                            ch.set_active(False)
            return False
        GLib.timeout_add(500, drive)
    Gtk.main()


