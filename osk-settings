def add_menu():
    """Дописывает в osk.toml новые пункты меню значка (если их там ещё нет); остальной файл не трогает."""
    real = Path(os.path.realpath(CONF))
    text = real.read_text(encoding="utf-8")
    have = {m.get("label") for m in tomllib.loads(text).get("tray", {}).get("menu", [])}
    if not have:
        print("в osk.toml нет своего меню ([[tray.menu]]): используется встроенное, оно уже содержит новые пункты")
        return 0
    lines = text.split("\n")
    added = []
    for label, block in NEW_MENU:
        if label in have:
            continue
        at = None                                           # перед разделом «Плавающая:», иначе в конец файла
        for i, ln in enumerate(lines):
            if ln.strip().startswith("label") and "Плавающая:" in ln:
                at = i - 1
                while at > 0 and not lines[at].startswith("[[tray.menu]]"):
                    at -= 1
                break
        new = block.rstrip("\n").split("\n") + [""]
        if at is None:
            while lines and lines[-1].strip() == "":
                lines.pop()
            lines += [""] + new
        else:
            lines[at:at] = new
        added.append(label)
    if not added:
        print("все пункты меню уже есть")
        return 0
    out = "\n".join(lines).rstrip("\n") + "\n"
    tomllib.loads(out)
    fd, tmp = tempfile.mkstemp(dir=str(real.parent), prefix=".osk-settings-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(out)
    os.chmod(tmp, real.stat().st_mode & 0o7777)
    os.replace(tmp, real)
    print("добавлены пункты меню:", ", ".join(added), "- перезапусти значок: osk-tray restart")
    return 0


def cli_set(key, raw):
